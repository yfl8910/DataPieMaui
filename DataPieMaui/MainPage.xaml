<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:DataPieMaui.Controls" xmlns:vm="clr-namespace:DataPieMaui.ViewModels" xmlns:local="clr-namespace:DataPieMaui" xmlns:services="clr-namespace:DataPieMaui.Services" x:DataType="vm:WorkspaceState" x:Class="DataPieMaui.MainPage" Title="DataPieMaui">
  <Grid RowDefinitions="Auto,*,Auto" Padding="24" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <VerticalStackLayout Spacing="3"><Label Text="DataPieMaui" FontSize="28" FontAttributes="Bold" /><Label Text="Database workspace · Windows" TextColor="#68778C" /></VerticalStackLayout>
      <Label Grid.Column="1" Text="{Binding Connection}" VerticalOptions="Center" FontAttributes="Bold" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="20">
      <VerticalStackLayout Spacing="10" IsEnabled="{Binding Idle}">
        <Button Text="Database connection" Clicked="Navigate" CommandParameter="Connections" />
        <Button Text="SQL query" Clicked="Navigate" CommandParameter="Query" IsVisible="{Binding IsConnected}" />
        <Button Text="Import data" Clicked="Navigate" CommandParameter="Import" IsVisible="{Binding IsConnected}" />
        <Button Text="Batch export" Clicked="Navigate" CommandParameter="Export" IsVisible="{Binding IsConnected}" />
        <Button Text="Stored procedures" Clicked="Navigate" CommandParameter="Procedures" IsVisible="{Binding IsConnected}" />
        <Button Text="Convert to SQLite" Clicked="Navigate" CommandParameter="Migration" IsVisible="{Binding CanConvertToSqlite}" />
        <Button Text="About DataPieMaui" Clicked="About" BackgroundColor="#68778C" />
      </VerticalStackLayout>
      <Grid Grid.Column="1" x:Name="Workspace" IsEnabled="{Binding Idle}">
        <Grid x:Name="ConnectionsPanel" RowDefinitions="Auto,Auto,*" RowSpacing="18">
          <Grid.Resources>
            <ControlTemplate x:Key="ConnectionTabTemplate" x:DataType="{x:Null}">
              <Grid RowDefinitions="*,3" HeightRequest="44" Padding="16,0" BackgroundColor="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CheckedStates">
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter TargetName="TabText" Property="Label.TextColor" Value="#176B64" />
                        <Setter TargetName="TabText" Property="Label.FontAttributes" Value="Bold" />
                        <Setter TargetName="TabIndicator" Property="BoxView.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked">
                      <VisualState.Setters>
                        <Setter TargetName="TabText" Property="Label.TextColor" Value="#68778C" />
                        <Setter TargetName="TabText" Property="Label.FontAttributes" Value="None" />
                        <Setter TargetName="TabIndicator" Property="BoxView.Opacity" Value="0" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label x:Name="TabText" Text="{TemplateBinding Content}" VerticalOptions="Center" HorizontalOptions="Center" />
                <BoxView x:Name="TabIndicator" Grid.Row="1" Color="#176B64" Opacity="0" />
              </Grid>
            </ControlTemplate>
          </Grid.Resources>
          <Label Text="Database connection" FontSize="22" FontAttributes="Bold" />
          <Grid Grid.Row="1" RowDefinitions="*,1">
            <HorizontalStackLayout Spacing="8">
              <RadioButton x:Name="SqlServerTab" Content="SQL Server" Value="SqlServer" GroupName="ConnectionTabs" ControlTemplate="{StaticResource ConnectionTabTemplate}" CheckedChanged="ConnectionTabChanged" />
              <RadioButton Content="SQLite" Value="Sqlite" GroupName="ConnectionTabs" ControlTemplate="{StaticResource ConnectionTabTemplate}" CheckedChanged="ConnectionTabChanged" />
              <RadioButton Content="Saved connections" Value="Saved" GroupName="ConnectionTabs" ControlTemplate="{StaticResource ConnectionTabTemplate}" CheckedChanged="ConnectionTabChanged" />
            </HorizontalStackLayout>
            <BoxView Grid.Row="1" Color="#D8E0E9" />
          </Grid>
          <ScrollView Grid.Row="2" x:Name="SqlServerConnectionPanel">
            <VerticalStackLayout Spacing="14">
              <Label Text="Connect to SQL Server" FontSize="18" FontAttributes="Bold" />
              <Grid ColumnDefinitions="*,180" ColumnSpacing="12"><Entry x:Name="Server" Text="(local)" Placeholder="Server, e.g. (local) or server\instance" /><Picker x:Name="Authentication" Grid.Column="1" SelectedIndexChanged="AuthenticationChanged" /></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Entry x:Name="UserName" Placeholder="Username" /><Entry x:Name="Password" Grid.Column="1" Placeholder="Password" IsPassword="True" /></Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Button Text="Load databases" Clicked="LoadDatabases" /><Picker x:Name="Databases" Grid.Column="1" Title="Select a database" /><Button Grid.Column="2" Text="Connect and save" Clicked="ConnectServer" /></Grid>
            </VerticalStackLayout>
          </ScrollView>
          <ScrollView Grid.Row="2" x:Name="SqliteConnectionPanel" IsVisible="False">
            <VerticalStackLayout Spacing="14">
              <Label Text="Connect to SQLite" FontSize="18" FontAttributes="Bold" />
              <Label Text="Choose a local database file. The connection is saved automatically after connecting." TextColor="#68778C" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Entry x:Name="SqlitePath" Placeholder="SQLite database file path" /><Button Grid.Column="1" Text="Browse file" Clicked="BrowseSqlite" /></Grid>
              <Button Text="Connect and save" Clicked="ConnectSqlite" HorizontalOptions="Start" />
            </VerticalStackLayout>
          </ScrollView>
          <ScrollView Grid.Row="2" x:Name="SavedConnectionPanel" IsVisible="False">
            <VerticalStackLayout Spacing="14">
              <Label Text="Saved connections" FontSize="18" FontAttributes="Bold" />
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="SavedConnections" Title="Select a saved connection" ItemDisplayBinding="{Binding Dbname, x:DataType=services:Dbinfo}" SelectedIndexChanged="SavedSelected" />
                <Button Grid.Column="1" Text="Connect" Clicked="ConnectSaved" /><Button Grid.Column="2" Text="Delete" Clicked="DeleteConnection" /><Button Grid.Column="3" Text="Import legacy settings" Clicked="ImportConnections" />
              </Grid>
              <BoxView HeightRequest="1" Color="#D8E0E9" Margin="0,10" />
              <Label Text="Edit connection" FontAttributes="Bold" />
              <Grid ColumnDefinitions="*,170" ColumnSpacing="12"><Entry x:Name="ConnectionName" Placeholder="Connection name" /><Picker x:Name="ConnectionType" Grid.Column="1" /></Grid>
              <Entry x:Name="ConnectionString" Placeholder="Connection string" />
              <FlexLayout Wrap="Wrap"><Button Text="Test" Clicked="TestConnection" Margin="0,0,8,8" /><Button Text="Save as new" Clicked="AddConnection" Margin="0,0,8,8" /><Button Text="Update selected" Clicked="UpdateConnection" Margin="0,0,8,8" /><Button Text="Connect" Clicked="ConnectEdited" Margin="0,0,8,8" /></FlexLayout>
            </VerticalStackLayout>
          </ScrollView>
        </Grid>
        <Grid x:Name="QueryPanel" IsVisible="False" RowDefinitions="Auto,Auto,160,Auto,*,Auto" RowSpacing="10">
          <Label Text="SQL query" FontSize="22" FontAttributes="Bold" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><Picker x:Name="QueryTable" Title="Select a table" /><Button Grid.Column="1" Text="SELECT" Clicked="GenerateSelect" /><Button Grid.Column="2" Text="UPDATE" Clicked="GenerateUpdate" /><Button Grid.Column="3" Text="DELETE" Clicked="GenerateDelete" /></Grid>
          <Editor Grid.Row="2" x:Name="SqlEditor" Placeholder="Enter SQL. Preview shows up to 1,000 rows; export reads the full result." FontFamily="Consolas" FontSize="14" />
          <FlexLayout Grid.Row="3" Wrap="Wrap" JustifyContent="Start">
            <Button Text="Preview query" Clicked="Preview" Margin="0,0,8,6" /><Button Text="Run SQL" Clicked="ExecuteSql" Margin="0,0,8,6" /><Button Text="Query to Excel" Clicked="ExportQueryExcel" Margin="0,0,8,6" /><Button Text="Query to CSV" Clicked="ExportQueryCsv" Margin="0,0,8,6" /><Button Text="Table to Excel" Clicked="ExportTableExcel" Margin="0,0,8,6" /><Button Text="Table to CSV" Clicked="ExportTableCsv" Margin="0,0,8,6" />
          </FlexLayout>
          <VerticalStackLayout Grid.Row="4" Spacing="12" Padding="0,12">
            <Label x:Name="QuerySummary" Text="Run a preview to open the result table in a separate window." TextColor="#68778C" />
            <Button x:Name="OpenResultsButton" Text="Open results" Clicked="OpenResults" IsEnabled="False" HorizontalOptions="Start" />
            <Label Text="Results open in a separate window with sorting, paging, and copy controls. A new preview updates that window." TextColor="#68778C" />
          </VerticalStackLayout>
        </Grid>
        <ScrollView x:Name="ImportPanel" IsVisible="False">
          <VerticalStackLayout Spacing="14">
            <Label Text="Import data" FontSize="22" FontAttributes="Bold" /><Picker x:Name="ImportTable" Title="Target table" />
            <HorizontalStackLayout Spacing="8"><Button Text="Export blank template" Clicked="ExportTemplate" /><Button Text="Clear target table" Clicked="ClearTable" BackgroundColor="#A43636" /></HorizontalStackLayout>
            <Label Text="Single file: Excel, CSV, or a SQLite database containing a table with the same name" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="ImportPath" Placeholder="Import file path" /><Button Grid.Column="1" Text="Browse file" Clicked="BrowseImport" /></Grid><Button Text="Import file" Clicked="ImportFile" HorizontalOptions="Start" />
            <Label Text="Batch import: append each CSV and XLSX file in the folder to the target table" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="ImportFolder" Placeholder="Import folder" /><Button Grid.Column="1" Text="Browse folder" Clicked="BrowseImportFolder" /></Grid><Button Text="Import folder" Clicked="ImportDirectory" HorizontalOptions="Start" />
          </VerticalStackLayout>
        </ScrollView>
        <Grid x:Name="ExportPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <Label Text="Batch export" FontSize="22" FontAttributes="Bold" />
          <VerticalStackLayout Grid.Row="1" Spacing="8"><HorizontalStackLayout Spacing="8"><Button Text="Select all" Clicked="SelectAllExports" /><Button Text="Clear selection" Clicked="ClearExports" /></HorizontalStackLayout><Label Text="Select tables or views to export to multiple worksheets or CSV files" /></VerticalStackLayout>
          <CollectionView Grid.Row="2" x:Name="ExportObjects"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SelectableObject"><HorizontalStackLayout Spacing="8" Padding="0,4"><CheckBox IsChecked="{Binding Selected}" /><Label Text="{Binding Kind}" WidthRequest="50" VerticalOptions="Center" TextColor="#68778C" /><Label Text="{Binding Name}" VerticalOptions="Center" /></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
          <HorizontalStackLayout Grid.Row="3" Spacing="8"><Button Text="Excel (MiniExcel)" Clicked="ExportMiniExcel" /><Button Text="Excel (EPPlus)" Clicked="ExportEpplus" /><Button Text="CSV folder" Clicked="ExportCsvFolder" /></HorizontalStackLayout>
        </Grid>
        <Grid x:Name="ProceduresPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <Label Text="Stored procedures" FontSize="22" FontAttributes="Bold" /><Label Grid.Row="1" Text="Run procedures without required parameters. Partially converted SQLite scripts show warnings after execution." />
          <CollectionView Grid.Row="2" x:Name="ProcedureObjects"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SelectableObject"><HorizontalStackLayout Spacing="8" Padding="0,4"><CheckBox IsChecked="{Binding Selected}" /><Label Text="{Binding Name}" VerticalOptions="Center" /></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
          <HorizontalStackLayout Grid.Row="3" Spacing="8"><Button Text="Run selected procedures" Clicked="RunProcedures" /><Button Text="Clear selection" Clicked="ClearProcedures" /></HorizontalStackLayout>
        </Grid>
        <ScrollView x:Name="MigrationPanel" IsVisible="False"><VerticalStackLayout Spacing="16">
          <Label Text="SQL Server → SQLite" FontSize="22" FontAttributes="Bold" />
          <Label Text="Export tables, supported views, and procedure scripts. Keep the StoredProcedures folder alongside the database." />
          <Label Text="Unsupported SQL is reported as a conversion warning. Cancellation or failure may leave an incomplete database." />
          <Button Text="Choose destination and convert" Clicked="ConvertSqlite" HorizontalOptions="Start" />
          <Label Text="Progress appears at the bottom of the window. You can request cancellation at any time." TextColor="#68778C" />
        </VerticalStackLayout></ScrollView>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />
      <Label Grid.Column="1" Text="{Binding Status}" MaxLines="3" LineBreakMode="TailTruncation" VerticalOptions="Center" />
      <Button Grid.Column="2" Text="Cancel conversion" IsVisible="{Binding Converting}" Clicked="CancelConversion" BackgroundColor="#A43636" />
    </Grid>
  </Grid>
</ContentPage>
