<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:DataPieMaui.Controls" xmlns:vm="clr-namespace:DataPieMaui.ViewModels" xmlns:local="clr-namespace:DataPieMaui" xmlns:services="clr-namespace:DataPieMaui.Services" x:DataType="vm:WorkspaceState" x:Class="DataPieMaui.MainPage" Title="DataPieMaui">
  <Grid RowDefinitions="Auto,*,Auto" Padding="24" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <VerticalStackLayout Spacing="3"><Label Text="DataPieMaui" FontSize="28" FontAttributes="Bold" /><Label Text="数据库工作台 · Windows" TextColor="#68778C" /></VerticalStackLayout>
      <Label Grid.Column="1" Text="{Binding Connection}" VerticalOptions="Center" FontAttributes="Bold" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="160,*" ColumnSpacing="20">
      <VerticalStackLayout Spacing="10" IsEnabled="{Binding Idle}">
        <Button Text="数据库连接" Clicked="Navigate" CommandParameter="Connections" />
        <Button Text="SQL 查询" Clicked="Navigate" CommandParameter="Query" IsVisible="{Binding IsConnected}" />
        <Button Text="数据导入" Clicked="Navigate" CommandParameter="Import" IsVisible="{Binding IsConnected}" />
        <Button Text="批量导出" Clicked="Navigate" CommandParameter="Export" IsVisible="{Binding IsConnected}" />
        <Button Text="存储过程" Clicked="Navigate" CommandParameter="Procedures" IsVisible="{Binding IsConnected}" />
        <Button Text="转为 SQLite" Clicked="Navigate" CommandParameter="Migration" IsVisible="{Binding CanConvertToSqlite}" />
        <Button Text="关于 DataPieMaui" Clicked="About" BackgroundColor="#68778C" />
      </VerticalStackLayout>
      <Grid Grid.Column="1" x:Name="Workspace" IsEnabled="{Binding Idle}">
        <Grid x:Name="ConnectionsPanel" RowDefinitions="Auto,Auto,*" RowSpacing="18">
          <Grid.Resources>
            <ControlTemplate x:Key="ConnectionTabTemplate" x:DataType="{x:Null}">
              <Grid RowDefinitions="*,3" HeightRequest="44" Padding="16,0" BackgroundColor="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CheckedStates">
                    <VisualState x:Name="Checked">
                      <VisualState.Setters>
                        <Setter TargetName="TabText" Property="Label.TextColor" Value="#176B64" />
                        <Setter TargetName="TabText" Property="Label.FontAttributes" Value="Bold" />
                        <Setter TargetName="TabIndicator" Property="BoxView.Opacity" Value="1" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Unchecked">
                      <VisualState.Setters>
                        <Setter TargetName="TabText" Property="Label.TextColor" Value="#68778C" />
                        <Setter TargetName="TabText" Property="Label.FontAttributes" Value="None" />
                        <Setter TargetName="TabIndicator" Property="BoxView.Opacity" Value="0" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Label x:Name="TabText" Text="{TemplateBinding Content}" VerticalOptions="Center" HorizontalOptions="Center" />
                <BoxView x:Name="TabIndicator" Grid.Row="1" Color="#176B64" Opacity="0" />
              </Grid>
            </ControlTemplate>
          </Grid.Resources>
          <Label Text="数据库连接" FontSize="22" FontAttributes="Bold" />
          <Grid Grid.Row="1" RowDefinitions="*,1">
            <HorizontalStackLayout Spacing="8">
              <RadioButton x:Name="SqlServerTab" Content="SQL Server" Value="SqlServer" GroupName="ConnectionTabs" ControlTemplate="{StaticResource ConnectionTabTemplate}" CheckedChanged="ConnectionTabChanged" />
              <RadioButton Content="SQLite" Value="Sqlite" GroupName="ConnectionTabs" ControlTemplate="{StaticResource ConnectionTabTemplate}" CheckedChanged="ConnectionTabChanged" />
              <RadioButton Content="已保存的连接" Value="Saved" GroupName="ConnectionTabs" ControlTemplate="{StaticResource ConnectionTabTemplate}" CheckedChanged="ConnectionTabChanged" />
            </HorizontalStackLayout>
            <BoxView Grid.Row="1" Color="#D8E0E9" />
          </Grid>
          <ScrollView Grid.Row="2" x:Name="SqlServerConnectionPanel">
            <VerticalStackLayout Spacing="14">
              <Label Text="连接 SQL Server 数据库" FontSize="18" FontAttributes="Bold" />
              <Grid ColumnDefinitions="*,180" ColumnSpacing="12"><Entry x:Name="Server" Text="(local)" Placeholder="服务器，例如 localhost 或 server\instance" /><Picker x:Name="Authentication" Grid.Column="1" SelectedIndexChanged="AuthenticationChanged" /></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Entry x:Name="UserName" Placeholder="用户名" /><Entry x:Name="Password" Grid.Column="1" Placeholder="密码" IsPassword="True" /></Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Button Text="获取数据库" Clicked="LoadDatabases" /><Picker x:Name="Databases" Grid.Column="1" Title="选择数据库" /><Button Grid.Column="2" Text="连接并保存" Clicked="ConnectServer" /></Grid>
              <BoxView HeightRequest="1" Color="#D8E0E9" Margin="0,10" />
              <Label Text="本机服务" FontAttributes="Bold" />
              <HorizontalStackLayout Spacing="8"><Button Text="启动本机 SQL Server" Clicked="StartService" BackgroundColor="#68778C" /><Button Text="停止本机 SQL Server" Clicked="StopService" BackgroundColor="#68778C" /></HorizontalStackLayout>
            </VerticalStackLayout>
          </ScrollView>
          <ScrollView Grid.Row="2" x:Name="SqliteConnectionPanel" IsVisible="False">
            <VerticalStackLayout Spacing="14">
              <Label Text="连接 SQLite 数据库" FontSize="18" FontAttributes="Bold" />
              <Label Text="选择本机数据库文件，连接后会自动保存配置。" TextColor="#68778C" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Entry x:Name="SqlitePath" Placeholder="SQLite 数据库文件路径" /><Button Grid.Column="1" Text="浏览文件" Clicked="BrowseSqlite" /></Grid>
              <Button Text="连接并保存" Clicked="ConnectSqlite" HorizontalOptions="Start" />
            </VerticalStackLayout>
          </ScrollView>
          <ScrollView Grid.Row="2" x:Name="SavedConnectionPanel" IsVisible="False">
            <VerticalStackLayout Spacing="14">
              <Label Text="已保存的连接" FontSize="18" FontAttributes="Bold" />
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="SavedConnections" Title="选择已保存的连接" ItemDisplayBinding="{Binding Dbname, x:DataType=services:Dbinfo}" SelectedIndexChanged="SavedSelected" />
                <Button Grid.Column="1" Text="连接" Clicked="ConnectSaved" /><Button Grid.Column="2" Text="删除" Clicked="DeleteConnection" /><Button Grid.Column="3" Text="导入旧配置" Clicked="ImportConnections" />
              </Grid>
              <BoxView HeightRequest="1" Color="#D8E0E9" Margin="0,10" />
              <Label Text="编辑连接配置" FontAttributes="Bold" />
              <Grid ColumnDefinitions="*,170" ColumnSpacing="12"><Entry x:Name="ConnectionName" Placeholder="连接名称" /><Picker x:Name="ConnectionType" Grid.Column="1" /></Grid>
              <Entry x:Name="ConnectionString" Placeholder="连接字符串" />
              <FlexLayout Wrap="Wrap"><Button Text="测试" Clicked="TestConnection" Margin="0,0,8,8" /><Button Text="新增保存" Clicked="AddConnection" Margin="0,0,8,8" /><Button Text="更新所选" Clicked="UpdateConnection" Margin="0,0,8,8" /><Button Text="连接此配置" Clicked="ConnectEdited" Margin="0,0,8,8" /></FlexLayout>
            </VerticalStackLayout>
          </ScrollView>
        </Grid>
        <Grid x:Name="QueryPanel" IsVisible="False" RowDefinitions="Auto,Auto,160,Auto,*,Auto" RowSpacing="10">
          <Label Text="SQL 查询" FontSize="22" FontAttributes="Bold" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><Picker x:Name="QueryTable" Title="选择数据表" /><Button Grid.Column="1" Text="SELECT" Clicked="GenerateSelect" /><Button Grid.Column="2" Text="UPDATE" Clicked="GenerateUpdate" /><Button Grid.Column="3" Text="DELETE" Clicked="GenerateDelete" /></Grid>
          <Editor Grid.Row="2" x:Name="SqlEditor" Placeholder="输入 SQL；预览最多显示 1,000 行，导出读取完整结果。" FontFamily="Consolas" FontSize="14" />
          <FlexLayout Grid.Row="3" Wrap="Wrap" JustifyContent="Start">
            <Button Text="查询预览" Clicked="Preview" Margin="0,0,8,6" /><Button Text="执行 SQL" Clicked="ExecuteSql" Margin="0,0,8,6" /><Button Text="导出查询 Excel" Clicked="ExportQueryExcel" Margin="0,0,8,6" /><Button Text="导出查询 CSV" Clicked="ExportQueryCsv" Margin="0,0,8,6" /><Button Text="导出整表 Excel" Clicked="ExportTableExcel" Margin="0,0,8,6" /><Button Text="导出整表 CSV" Clicked="ExportTableCsv" Margin="0,0,8,6" />
          </FlexLayout>
          <controls:QueryResultsView Grid.Row="4" x:Name="Results" />
          <HorizontalStackLayout Grid.Row="5" Spacing="8"><Button Text="复制选中行" Clicked="CopyRow" /><Button Text="复制全部预览" Clicked="CopyAll" /><Label Text="点击列标题排序 · 横向滚动查看全部列" VerticalOptions="Center" /></HorizontalStackLayout>
        </Grid>
        <ScrollView x:Name="ImportPanel" IsVisible="False">
          <VerticalStackLayout Spacing="14">
            <Label Text="数据导入" FontSize="22" FontAttributes="Bold" /><Picker x:Name="ImportTable" Title="目标数据表" />
            <Label Text="单文件：Excel、CSV 或同名表的 SQLite 数据库" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="ImportPath" Placeholder="导入文件路径" /><Button Grid.Column="1" Text="浏览文件" Clicked="BrowseImport" /></Grid><Button Text="导入文件" Clicked="ImportFile" HorizontalOptions="Start" />
            <Label Text="批量导入：文件夹内的 CSV、XLSX 文件将依次追加到目标表" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="ImportFolder" Placeholder="导入文件夹" /><Button Grid.Column="1" Text="浏览文件夹" Clicked="BrowseImportFolder" /></Grid><Button Text="导入文件夹" Clicked="ImportDirectory" HorizontalOptions="Start" />
            <HorizontalStackLayout Spacing="8"><Button Text="导出空白模板" Clicked="ExportTemplate" /><Button Text="清空目标表" Clicked="ClearTable" BackgroundColor="#A43636" /></HorizontalStackLayout>
          </VerticalStackLayout>
        </ScrollView>
        <Grid x:Name="ExportPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <Label Text="批量导出" FontSize="22" FontAttributes="Bold" />
          <HorizontalStackLayout Grid.Row="1" Spacing="8"><Button Text="全选" Clicked="SelectAllExports" /><Button Text="清除选择" Clicked="ClearExports" /><Label Text="勾选表或视图，导出到多个工作表或 CSV 文件" VerticalOptions="Center" /></HorizontalStackLayout>
          <CollectionView Grid.Row="2" x:Name="ExportObjects"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SelectableObject"><HorizontalStackLayout Spacing="8" Padding="0,4"><CheckBox IsChecked="{Binding Selected}" /><Label Text="{Binding Kind}" WidthRequest="50" VerticalOptions="Center" TextColor="#68778C" /><Label Text="{Binding Name}" VerticalOptions="Center" /></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
          <HorizontalStackLayout Grid.Row="3" Spacing="8"><Button Text="Excel（MiniExcel）" Clicked="ExportMiniExcel" /><Button Text="Excel（EPPlus）" Clicked="ExportEpplus" /><Button Text="CSV 文件夹" Clicked="ExportCsvFolder" /></HorizontalStackLayout>
        </Grid>
        <Grid x:Name="ProceduresPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <Label Text="存储过程" FontSize="22" FontAttributes="Bold" /><Label Grid.Row="1" Text="运行无必填参数的过程；SQLite 部分转换脚本执行后会显示警告。" />
          <CollectionView Grid.Row="2" x:Name="ProcedureObjects"><CollectionView.ItemTemplate><DataTemplate x:DataType="local:SelectableObject"><HorizontalStackLayout Spacing="8" Padding="0,4"><CheckBox IsChecked="{Binding Selected}" /><Label Text="{Binding Name}" VerticalOptions="Center" /></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
          <HorizontalStackLayout Grid.Row="3" Spacing="8"><Button Text="运行所选过程" Clicked="RunProcedures" /><Button Text="清除选择" Clicked="ClearProcedures" /></HorizontalStackLayout>
        </Grid>
        <ScrollView x:Name="MigrationPanel" IsVisible="False"><VerticalStackLayout Spacing="16">
          <Label Text="SQL Server → SQLite" FontSize="22" FontAttributes="Bold" />
          <Label Text="导出数据表、可转换的视图及存储过程脚本。脚本保存在数据库旁的 StoredProcedures 文件夹，请一起保留。" />
          <Label Text="不支持的 SQL 会记录为转换警告。取消或失败后，输出数据库可能不完整。" />
          <Button Text="选择输出位置并开始转换" Clicked="ConvertSqlite" HorizontalOptions="Start" />
          <Label Text="转换进度显示在窗口底部；可随时请求取消。" TextColor="#68778C" />
        </VerticalStackLayout></ScrollView>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />
      <Label Grid.Column="1" Text="{Binding Status}" MaxLines="3" LineBreakMode="TailTruncation" VerticalOptions="Center" />
      <Button Grid.Column="2" Text="取消转换" IsVisible="{Binding Converting}" Clicked="CancelConversion" BackgroundColor="#A43636" />
    </Grid>
  </Grid>
</ContentPage>
