@inherits LocalizedComponent
@using System.Data
@using System.Globalization
@using DataPieCore
@using DataPieMaui.Services.Shared
@using Microsoft.JSInterop
@inject IJSRuntime JS

@implements IDisposable
<CascadingValue Name="UiLanguage" Value="CurrentLanguage">
<div lang="@CurrentLanguage" style="display: contents">
@if (Preview != null)
{
<main class="preview-page" inert="@searchDialogOpen">
    <header class="preview-header"><span title="@previewSnapshot?.Connection">@previewSnapshot?.Connection</span><span title="@previewSnapshot?.Source">@previewSnapshot?.Source</span><span class="badge">@L("Read-only", "只读")</span>@if (previewSnapshot != null) { <span>@previewSnapshot.RowCount.ToString("N0") rows · @previewSnapshot.ColumnCount columns</span> }</header>
    @if (previewSnapshot is null)
    {
        <div class="empty">@L("Run a query in the main window to view results.", "请在主窗口执行查询以查看结果。")</div>
    }
    else
    {
        <SimpleSearch Fields="PreviewSearchFields" Value="previewDraftConditions" ValueChanged="SetPreviewConditions" OnSearch="ApplyPreviewConditionsAsync" OnClear="ClearAdvancedSearchAsync" Disabled="@(previewBusy || previewSnapshot.IsCapturing)" Notice="">
            <Actions><button type="button" @onclick="OpenAdvancedSearch" disabled="@previewSnapshot.IsCapturing">@L("Advanced filters", "高级筛选")</button></Actions>
        </SimpleSearch>
        @if (previewAdvanced != null) { <p>Advanced filters are applied.</p> }
        @if (!string.IsNullOrEmpty(dialogError)) { <p class="notice" role="alert">@dialogError</p> }
        @if (previewSnapshot.IsCapturing)
        {
            <p class="notice">@L("Saving the full result. Search will be available when it finishes.", "正在保存完整结果，完成后即可搜索。") <button type="button" @onclick="previewSnapshot.CancelCapture">@L("Cancel", "取消")</button></p>
        }
        else if (!previewSnapshot.HasFullResult) { <p class="notice">@L("Full-result search is unavailable. Run the query again.", "无法搜索完整结果，请重新执行查询。")</p> }
        @if (previewSnapshot.Truncated)
        {
            <div class="notice">Showing the first 1,000 matching rows. @if (previewSnapshot.HasFullResult) { <text>@L("Search covers the complete query result.", "搜索范围包括全部查询结果。")</text> }</div>
        }
        <TableDataGrid TRow="int" Rows="@previewOrder.Skip(previewPage * PreviewPageSize).Take(PreviewPageSize)" ColumnCount="previewSnapshot.ColumnCount"
                       CellText="previewSnapshot.FormatCell" CellIsNull="previewSnapshot.IsNull" IsSelected="@(_ => false)"
                       SortState="PreviewSortState" EmptyText="@(PreviewHasFilter ? L("No matching records in the loaded preview.", "已加载的预览中没有匹配记录。") : L("The query returned no rows.", "查询未返回数据。"))">
            <LeadingHeader>#</LeadingHeader>
            <ColumnHeader Context="column"><button @onclick="() => Sort(column)" disabled="@(previewSnapshot.GetColumnType(column) == typeof(byte[]))">@previewSnapshot.GetColumnName(column) @(previewSortColumn == column ? (previewDescending ? "▼" : "▲") : "")</button></ColumnHeader>
            <LeadingCell Context="index">@(index + 1)</LeadingCell>
        </TableDataGrid>
        <footer>
            <span role="status">@previewMessage</span>
            <div class="pagination"><button @onclick="Previous" disabled="@(previewPage == 0)">@L("Previous", "上一页")</button><span>Page @(previewPage + 1)/@PreviewPageCount · @previewOrder.Length.ToString("N0") rows</span><button @onclick="Next" disabled="@(previewPage + 1 >= PreviewPageCount)">@L("Next", "下一页")</button></div>
        </footer>
    }
</main>

}
else
{
<main inert="@(DialogOpen || searchDialogOpen)">
    <header><div><p>@ConnectionLabel</p><p>@Session.TableName</p></div><span class="badge">@(Session.CanEdit ? "Table data" : "Read-only")</span></header>
    <div class="toolbar">
        <button @onclick="BeginAdd" disabled="@(Session.IsBusy || DialogOpen || !Session.CanInsert)">@L("Add record", "新增记录")</button>
        <button @onclick="BeginImport" disabled="@(Session.IsBusy || DialogOpen || Desktop == null)">@L("Import file", "导入文件")</button>
        <button @onclick="BeginEdit" disabled="@(Session.IsBusy || DialogOpen || selected.Count != 1 || !Session.CanEdit)">@L("EDIT", "编辑")</button>
        <button @onclick="ExportExcelAsync" disabled="@(Session.IsBusy || DialogOpen)" title="Export all rows matching the applied search, across all pages">@L("Export Excel", "导出 Excel")</button>
        <button @onclick="RequestDelete" disabled="@(Session.IsBusy || DialogOpen || selected.Count == 0 || !Session.CanEdit)">@L("Delete selected", "删除选中项")</button>
        <button @onclick="() => LoadAsync(Session.Page)" disabled="@(Session.IsBusy || DialogOpen)">@L("Refresh", "刷新")</button>
    </div>
    <SimpleSearch Fields="EditorSearchFields" Value="editorConditions" ValueChanged="SetEditorConditions" OnSearch="ApplyEditorConditionsAsync" OnClear="ClearAdvancedSearchAsync" Disabled="@(Session.IsBusy || DialogOpen)">
        <Actions><button type="button" @onclick="OpenAdvancedSearch">@L("Advanced filters", "高级筛选")</button></Actions>
    </SimpleSearch>
    @if (Session.AdvancedFilters != null) { <p>Advanced filters are applied. A simple search replaces them.</p> }
    @if (!string.IsNullOrEmpty(dialogError)) { <p class="notice" role="alert">@dialogError</p> }
    @if (Session.Conditions.Count > 0) { <p>Active conditions: @string.Join(" AND ", Session.Conditions.Select(c => c.Column + ": " + c.Text))</p> }
    @if (!Session.CanEdit) { <p class="notice">@Session.ReadOnlyReason</p> }
    @if (Session.CanEdit) { <p class="notice">@Session.IdentityNotice</p> }
    <TableDataGrid TRow="DataRow" Rows="@(Session.Data.Rows.Cast<DataRow>())" ColumnCount="Session.Data.Columns.Count"
                   CellText="EditorCellText" CellIsNull="EditorCellIsNull" IsSelected="selected.Contains"
                   EmptyText="@(Session.SearchColumn != null || Session.AdvancedFilters != null ? "No matching records." : "No records.")">
        <LeadingHeader><label class="page-selection"><input type="checkbox" data-page-select-all data-partial="@(selected.Count > 0 && !AllPageSelected ? "true" : "false")" aria-label="Select all records on this page" checked="@AllPageSelected" @onchange="e => SelectPage(e.Value is true)" disabled="@(Session.IsBusy || DialogOpen || Session.Data.Rows.Count == 0)" /> @L("Select all", "全选")</label></LeadingHeader>
        <ColumnHeader Context="column">@Session.Data.Columns[column].ColumnName</ColumnHeader>
        <LeadingCell Context="row"><input type="checkbox" aria-label="Select record" checked="@selected.Contains(row)" @onchange="e => Select(row, e.Value is true)" disabled="@(Session.IsBusy || DialogOpen)" /></LeadingCell>
    </TableDataGrid>
    <footer><span role="status" style="white-space:pre-wrap">@message</span><div class="pagination">
        <button @onclick="() => LoadAsync(Session.Page - 1, refreshCount: false)" disabled="@(Session.Page == 0 || Session.IsBusy || DialogOpen)">@L("Previous", "上一页")</button>
        <span>Page @(Session.Page + 1)/@(Math.Max(1L, Session.TotalRows / TableEditorSession.PageSize + (Session.TotalRows % TableEditorSession.PageSize > 0 ? 1 : 0))) · @Session.TotalRows.ToString("N0") rows</span>
        <button @onclick="() => LoadAsync(Session.Page + 1, refreshCount: false)" disabled="@(!Session.HasNext || Session.IsBusy || DialogOpen)">@L("Next", "下一页")</button>
    </div></footer>
</main>

@if (importOpen)
{
    <div class="modal-overlay">
        <section class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="editor-dialog-title" data-busy="@(Session.IsBusy ? "true" : "false")" tabindex="-1">
            <div class="dialog-header"><h2 id="editor-dialog-title">@L("Import file", "导入文件")</h2><button aria-label="@L("Close dialog", "关闭对话框")" data-dialog-close @onclick="RequestClose" disabled="@Session.IsBusy">×</button></div>
            <div class="dialog-body">
                <p>@ConnectionLabel</p>
                <TableImportView Options="importOptions!" Disabled="Session.IsBusy" OnComplete="CompleteImportAsync" />
                @if (!string.IsNullOrEmpty(dialogError)) { <div class="dialog-error" role="alert">@dialogError</div> }
            </div>
        </section>
    </div>
}
else if (DialogOpen)
{
    <div class="modal-overlay">
        <section @key="DialogKey" class="editor-dialog" data-wide="@(!confirmDelete && Session.Data.Columns.Count > 10 ? "true" : "false")" data-movable="@(confirmDelete ? "false" : "true")" data-busy="@(Session.IsBusy ? "true" : "false")" role="@(confirmDelete ? "alertdialog" : "dialog")" aria-modal="true" aria-labelledby="editor-dialog-title" tabindex="-1">
            <div class="dialog-header" data-dialog-drag tabindex="@(confirmDelete ? -1 : 0)" aria-label="@(confirmDelete ? null : "Move dialog using arrow keys or drag the title bar")">
                <h2 id="editor-dialog-title">@(confirmDelete ? "Delete selected records" : adding ? "New record" : "Edit record")</h2>
                <div class="dialog-window-actions">
                    @if (!confirmDelete) { <button type="button" aria-label="Maximize dialog" title="Maximize dialog" data-dialog-maximize disabled="@Session.IsBusy">□</button> }
                    <button aria-label="@L("Close dialog", "关闭对话框")" data-dialog-close @onclick="RequestClose" disabled="@Session.IsBusy">×</button>
                </div>
            </div>
            <div class="dialog-body">
                <p>@ConnectionLabel · @Session.TableName</p>
                @if (confirmDelete)
                {
                    <p class="notice">Delete @selected.Count selected records? Database cascades and triggers may affect related data. This cannot be undone.</p>
                    <p>Selected record keys</p>
                    <ul>@foreach (var row in selected.Take(20)) { <li>@RecordKey(row)</li> }</ul>
                    @if (selected.Count > 20) { <p>And @(selected.Count - 20) more records.</p> }
                }
                else if (editing != null || adding)
                {
                    <p>Use yyyy-MM-dd for dates and a dot for decimals. Read-only fields identify the record or are managed by the database.</p>
                    @if (adding) { <p>Required fields must be supplied. Untouched optional fields use their database default or NULL. Generated fields are filled automatically.</p> }
                    <div class="edit-fields">
                    @foreach (DataColumn column in Session.Data.Columns)
                    {
                        string name = column.ColumnName;
                        bool editable = adding ? Session.IsInsertable(name) : Session.IsEditable(name);
                        <div class="edit-field @(IsLongText(column) ? "edit-field-long" : "")">
                            <label>@name
                                @if (editable)
                                {
                                    <textarea @bind="draft[name]" @bind:event="oninput" @bind:after="() => DraftChanged(name)" disabled="@Session.IsBusy" placeholder="@(adding ? (Session.HasDefault(name) ? "Database default" : Session.IsRequiredForInsert(name) ? "Required" : "Leave blank for NULL") : editing!.IsNull(name) ? "NULL" : null)" aria-label="@name"></textarea>
                                }
                                else { <input value="@(adding ? "Generated / read-only" : Format(editing![name]))" readonly aria-label="@name" /> }
                            </label>
                        </div>
                    }
                    </div>
                }
                @if (!string.IsNullOrEmpty(dialogError)) { <div class="dialog-error" role="alert">@dialogError</div> }
                @if (confirmDiscard) { <p class="notice" role="alert">Discard your unsaved changes?</p> }
            </div>
            <div class="dialog-actions">
                @if (confirmDiscard)
                {
                    <button @onclick="DiscardDraft" disabled="@Session.IsBusy">@L("Discard changes", "放弃更改")</button>
                    <button @onclick="() => confirmDiscard = false" disabled="@Session.IsBusy">@L("Keep editing", "继续编辑")</button>
                }
                else
                {
                    @if (confirmDelete) { <button class="danger" @onclick="DeleteAsync" disabled="@Session.IsBusy">@L("Confirm delete", "确认删除")</button> }
                    else { <button class="primary" @onclick="SaveAsync" disabled="@Session.IsBusy">@L("Save", "保存")</button> }
                    <button @onclick="RequestClose" disabled="@Session.IsBusy">@L("Cancel", "取消")</button>
                }
            </div>
            @if (!confirmDelete) { <button type="button" class="dialog-resize-handle" data-dialog-resize aria-label="Resize dialog using arrow keys or drag" title="Drag to resize; arrow keys also adjust size" disabled="@Session.IsBusy">◢</button> }
        </section>
    </div>
}

}
@if (searchDialogOpen)
{
    <AdvancedSearch Fields="AdvancedFields" Settings="AdvancedSettings" Validate="ValidateAdvanced" ExternalError="@dialogError" OnApply="ApplyAdvancedAsync" OnCancel="CloseAdvancedSearch" />
}
</div>
</CascadingValue>
@code {
    [Parameter] public string InitialLanguage { get; set; } = "en";
    protected override string CurrentLanguage => Language ?? InitialLanguage;
    [Parameter] public TableEditorSession Session { get; set; } = default!;
    [Parameter] public string ConnectionLabel { get; set; } = "";
    private readonly HashSet<DataRow> selected = [];
    private readonly Dictionary<string, string> draft = new();
    private DataRow? editing;
    private bool confirmDelete, confirmDiscard, adding;
    private bool DialogOpen => editing != null || adding || confirmDelete || importOpen;
    private bool previewBusy;
    private bool searchDialogOpen;
    private int filterEditorVersion;
    private AnalysisFilterConfig? previewAdvanced;
    private Func<Func<string, object>, bool>? previewMatcher;
    private static bool SupportedPreviewType(Type type) => type == typeof(string) || type == typeof(bool) || type == typeof(DateTime) || type == typeof(DateTimeOffset) || type == typeof(TimeSpan) || type == typeof(Guid) || type == typeof(byte) || type == typeof(sbyte) || type == typeof(short) || type == typeof(ushort) || type == typeof(int) || type == typeof(uint) || type == typeof(long) || type == typeof(ulong) || type == typeof(float) || type == typeof(double) || type == typeof(decimal);
    private IReadOnlyList<AnalysisFilterField> AdvancedFields => Preview == null ? Session.FilterFields : previewSnapshot == null ? [] : Enumerable.Range(0, previewSnapshot.ColumnCount).Where(i => SupportedPreviewType(previewSnapshot.GetColumnType(i)))
        .Select(i => new AnalysisFilterField(i.ToString(CultureInfo.InvariantCulture), TableEditorSession.FilterKind(previewSnapshot.GetColumnType(i)), previewSnapshot.GetColumnName(i))).ToArray();
    private AnalysisRequest AdvancedSettings => new([], [], Conditions: Preview == null ? Session.Conditions : previewConditions, Filters: Preview == null ? Session.AdvancedFilters : previewAdvanced);
    private bool PreviewHasFilter => previewConditions.Count > 0 || (previewAdvanced?.Groups.Any(g => g.Rules.Count > 0) ?? false) || (previewAdvanced?.CommonRules?.Count > 0);
    private SearchColumn ResolvePreviewColumn(string name)
    {
        if (previewSnapshot == null || !int.TryParse(name, out int index) || index < 0 || index >= previewSnapshot.ColumnCount || !SupportedPreviewType(previewSnapshot.GetColumnType(index))) throw new ArgumentException("Select a supported preview column.");
        return new SearchColumn(name, previewSnapshot.GetColumnType(index), name);
    }
    private Func<Func<string, object>, bool> PreviewMatcher(AnalysisFilterConfig config, out IReadOnlyCollection<string> matchColumns) =>
        AnalysisFilters.CreatePreviewMatcher(config, ResolvePreviewColumn,
            AdvancedFields.Where(f => f.Kind == "Text").Select(f => ResolvePreviewColumn(f.Name)).ToArray(), out matchColumns);
    private void ValidateAdvanced(AnalysisFilterConfig config) { if (Preview == null) Session.ValidateAdvanced(config); else PreviewMatcher(config, out _); }
    public void OpenAdvancedSearch() { if (!previewBusy && (Preview != null || (!Session.IsBusy && !DialogOpen))) { dialogError = ""; searchDialogOpen = true; } }
    private void CloseAdvancedSearch() { searchDialogOpen = false; dialogError = ""; }
    public async Task ApplyAdvancedAsync(AnalysisFilterConfig config)
    {
        if (previewBusy || (Preview == null && (Session.IsBusy || DialogOpen))) return;
        try
        {
            if (Preview != null)
            {
                var matcher = PreviewMatcher(config, out var matchColumns);
                var original = Preview.Current ?? throw new InvalidOperationException("The query result is no longer available.");
                if (!original.HasFullResult) throw new InvalidOperationException("Full-result search is unavailable for this preview. Run the query again.");
                previewBusy = true;
                try
                {
                    if (original.HasArchive)
                    {
                        var columns = matchColumns.Select(name => int.Parse(name, CultureInfo.InvariantCulture)).ToArray();
                        var filteredSnapshot = await Task.Run(() => original.SearchFull(matcher, columns));
                        if (previewDisposed || !ReferenceEquals(Preview.Current, original)) return;
                        previewSnapshot = filteredSnapshot; previewMatcher = null;
                        previewOrder = previewSortColumn >= 0 ? filteredSnapshot.Sort(previewSortColumn, previewDescending) : Enumerable.Range(0, filteredSnapshot.RowCount).ToArray();
                    }
                    else
                    {
                        previewSnapshot = original; previewMatcher = matcher;
                        var indices = previewSortColumn >= 0 ? original.Sort(previewSortColumn, previewDescending) : Enumerable.Range(0, original.RowCount).ToArray();
                        previewOrder = indices.Where(i => matcher(name => original.GetValue(i, int.Parse(name, CultureInfo.InvariantCulture)))).ToArray();
                    }
                    previewAdvanced = AnalysisFilters.Snapshot(config); previewPage = 0; previewSelected = null;
                    previewConditions = previewDraftConditions = []; previewMessage = "Search applied to the complete query result.";
                }
                finally { previewBusy = false; }
            }
            else
            {
                if (Session.IsBusy) return;
                Session.IsBusy = true;
                try { await Task.Run(() => Session.SearchAdvanced(config)); editorConditions = []; selected.Clear(); message = "Advanced search applied to the entire table."; }
                finally { Session.IsBusy = false; }
            }
            dialogError = ""; searchDialogOpen = false; filterEditorVersion++;
        }
        catch (Exception ex) { dialogError = ex.Message; }
    }
    public async Task ClearAdvancedSearchAsync()
    {
        if (Preview != null) { if (!previewBusy) ClearSearch(); return; }
        if (Session.IsBusy || DialogOpen) return;
        Session.IsBusy = true;
        try { await Task.Run(() => Session.SearchAdvanced(null)); editorConditions = []; selected.Clear(); dialogError = ""; filterEditorVersion++; message = "Search cleared."; }
        catch (Exception ex) { message = ex.Message; }
        finally { Session.IsBusy = false; }
    }
    private bool importOpen;
    private TableImportOptions? importOptions;
    public void BeginImport()
    {
        if (Preview != null || Session.IsBusy || DialogOpen || Desktop == null) return;
        importOptions ??= new TableImportOptions(Session.TableName, () => Desktop.OpenAsync(".xlsx", ".xls", ".csv", ".db"), () => Desktop.FolderAsync());
        dialogError = ""; importOpen = true;
    }
    public async Task CompleteImportAsync(bool accepted)
    {
        if (!importOpen || Session.IsBusy || importOptions == null) return;
        if (!accepted) { importOpen = false; dialogError = ""; return; }
        Session.IsBusy = true; dialogError = "";
        bool attempted = false;
        try
        {
            var options = importOptions;
            bool validate = options.ValidateLengths;
            Task ImportFile(string path)
            {
                attempted = true;
                return Task.Run(() => Session.Import((access, target, source) => DatabaseOperations.Import(path, target, access, validate, source)));
            }
            int count = 1;
            if (options.Batch)
            {
                string folder = Path.TrimEndingDirectorySeparator(Path.GetFullPath(options.Folder));
                if (!importBatches.TryGetValue(folder, out var batch))
                    importBatches.Add(folder, batch = BatchImportProgress.Open(folder));
                await batch.RunAsync(ImportFile);
                count = batch.Count;
                importBatches.Remove(folder);
            }
            else
            {
                if (!File.Exists(options.Path)) throw new FileNotFoundException("Select an existing file.");
                await ImportFile(options.Path);
            }
            importOpen = false; message = $"Imported {count} file(s). Current search remains applied.";
        }
        catch (BatchImportException ex) { dialogError = L(ex.Message, ex.ChineseMessage); }
        catch (Exception ex) { dialogError = ex.Message; }
        finally
        {
            if (attempted)
            {
                selected.Clear();
                try { await Task.Run(() => Session.LoadPage(Session.Page)); }
                catch (Exception ex) { message = "Refresh failed after import. Refresh before editing again. " + ex.Message; }
            }
            Session.IsBusy = false;
        }
    }
    private readonly Dictionary<string, BatchImportProgress> importBatches = new(StringComparer.OrdinalIgnoreCase);
    private string DialogKey => confirmDelete ? "delete" : adding ? "new" : "edit";
    private bool IsLongText(DataColumn column)
    {
        if (column.DataType != typeof(string) || editing == null || editing.IsNull(column)) return false;
        string value = Format(editing[column]);
        return value.Length > 160 || value.Contains('\n') || value.Contains('\r');
    }
    private readonly HashSet<string> touched = [];
    private string dialogError = "";
    private IReadOnlyList<SearchCondition> editorConditions = [];
    private IReadOnlyList<SearchField> EditorSearchFields => Session.Data.Columns.Cast<DataColumn>().Where(c => Session.IsSearchable(c.ColumnName))
        .Select(c => new SearchField(c.ColumnName, c.ColumnName, c.DataType == typeof(string) ? "Contains text" : c.DataType == typeof(DateTime) ? "yyyy-MM-dd or exact date/time" : "Exact value")).ToArray();
    private void SetEditorConditions(IReadOnlyList<SearchCondition> value) => editorConditions = value;
    public Task SearchAsync() => ApplyEditorConditionsAsync(editorConditions);
    public Task ClearSearchAsync() => ApplyEditorConditionsAsync(Array.Empty<SearchCondition>());
    private async Task ApplyEditorConditionsAsync(IReadOnlyList<SearchCondition> value)
    {
        if (Preview != null || Session.IsBusy || DialogOpen) return;
        Session.IsBusy = true;
        try
        {
            var snapshot = value.ToArray();
            await Task.Run(() => Session.Search(snapshot));
            editorConditions = snapshot; selected.Clear();
            message = Session.Conditions.Count == 0 ? "Search cleared." : "AND search applied to the entire table. Text matching follows database rules.";
        }
        catch (Exception ex) { message = ex.Message; }
        finally { Session.IsBusy = false; }
    }
    private string message = "Select one record to edit, or select records to delete. All table records are available through paging.";
    public async Task ExportExcelAsync()
    {
        if (Preview != null || Session.IsBusy || DialogOpen) return;
        Session.IsBusy = true;
        try
        {
            var path = await Desktop.SaveAsync(Session.TableName, ".xlsx");
            if (path == null) return;
            message = "Exporting all rows matching the applied search…";
            await Task.Run(() => Session.ExportExcel(path));
            message = "Export completed · File: " + System.IO.Path.GetFullPath(path);
        }
        catch (Exception ex) { message = "Export failed: " + ex.ToString(); }
        finally { Session.IsBusy = false; }
    }
    private static string Format(object value) => value switch
    {
        DBNull => "NULL", byte[] bytes => Convert.ToHexString(bytes),
        DateTime date => date.ToString("O", CultureInfo.InvariantCulture),
        DateTimeOffset date => date.ToString("O", CultureInfo.InvariantCulture),
        _ => Convert.ToString(value, CultureInfo.InvariantCulture) ?? ""
    };
    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("tableEditorModal.sync");
    public void Select(DataRow row, bool value) { if (Preview != null || Session.IsBusy || DialogOpen) return; if (value) selected.Add(row); else selected.Remove(row); }
    private static string EditorCellText(DataRow row, int column) => NumericDisplay.Format(row[column], CultureInfo.CurrentCulture) ?? Format(row[column]);
    private static bool EditorCellIsNull(DataRow row, int column) => row.IsNull(column);
    private bool AllPageSelected => Session.Data.Rows.Count > 0 && Session.Data.Rows.Cast<DataRow>().All(selected.Contains);
    public void SelectPage(bool value)
    {
        if (Preview != null || Session.IsBusy || DialogOpen) return;
        selected.Clear();
        if (value) foreach (DataRow row in Session.Data.Rows) selected.Add(row);
    }
    public void SetDraft(string name, string value) { if (Preview != null || Session.IsBusy || (!adding && editing == null) || !draft.ContainsKey(name)) return; draft[name] = value; DraftChanged(name); }
    private void DraftChanged(string name) { if (adding) touched.Add(name); UpdateDirty(); }
    private bool Dirty => adding ? touched.Count > 0 : editing != null && draft.Any(x => x.Value != (editing.IsNull(x.Key) ? "" : Format(editing[x.Key])));
    private void UpdateDirty() { Session.HasDraft = Dirty; confirmDiscard = false; }
    private string RecordKey(DataRow row) => string.Join(", ", Session.Data.Columns.Cast<DataColumn>().Where(c => Session.IsPrimaryKey(c.ColumnName)).Select(c => c.ColumnName + "=" + Format(row[c])));
    public void BeginEdit()
    {
        if (Preview != null || Session.IsBusy || DialogOpen || selected.Count != 1 || !Session.CanEdit) return;
        editing = selected.Single(); draft.Clear();
        foreach (DataColumn column in Session.Data.Columns)
            if (Session.IsEditable(column.ColumnName))
            {
                draft[column.ColumnName] = editing.IsNull(column) ? "" : Format(editing[column]);
            }
        dialogError = ""; confirmDiscard = false; Session.HasDraft = false;
    }
    public void BeginAdd()
    {
        if (Preview != null || Session.IsBusy || DialogOpen || !Session.CanInsert) return;
        adding = true; draft.Clear(); touched.Clear();
        foreach (DataColumn column in Session.Data.Columns)
            if (Session.IsInsertable(column.ColumnName)) draft[column.ColumnName] = "";
        dialogError = ""; confirmDiscard = false; Session.HasDraft = false;
    }
    private void Cancel() { editing = null; adding = false; draft.Clear(); touched.Clear(); Session.HasDraft = false; message = "Draft discarded."; }
    public void RequestClose()
    {
        if (Preview != null || Session.IsBusy) return;
        if (importOpen) { importOpen = false; dialogError = ""; return; }
        if (confirmDelete) { confirmDelete = false; dialogError = ""; return; }
        if (Dirty) { confirmDiscard = true; return; }
        Cancel();
    }
    public void DiscardDraft() { if (Preview != null || Session.IsBusy) return; confirmDiscard = false; dialogError = ""; Cancel(); }
    public void RequestDelete() { if (Preview == null && !Session.IsBusy && !DialogOpen && selected.Count > 0 && Session.CanEdit) { dialogError = ""; confirmDelete = true; } }
    private async Task LoadAsync(int page, bool refreshCount = true)
    {
        if (Preview != null || Session.IsBusy || DialogOpen) return;
        Session.IsBusy = true;
        try
        {
            await Task.Run(() =>
            {
                if (refreshCount) Session.LoadPage(page);
                else Session.NavigateToPage(page);
            });
            selected.Clear(); message = "Table page loaded.";
        }
        catch (Exception ex) { message = ex.ToString(); }
        finally { Session.IsBusy = false; }
    }
    public async Task SaveAsync()
    {
        if (Preview != null || Session.IsBusy || (!adding && editing == null)) return;
        Session.IsBusy = true;
        dialogError = "";
        try
        {
            bool inserting = adding;
            if (inserting)
            {
                var values = draft.Where(x => touched.Contains(x.Key) || Session.IsRequiredForInsert(x.Key))
                    .ToDictionary(x => x.Key, x => Session.Parse(x.Key, x.Value, false, forInsert: true));
                await Task.Run(() => Session.Insert(values));
            }
            else
            {
                var changes = draft.ToDictionary(x => x.Key, x => Session.Parse(x.Key, x.Value, editing!.IsNull(x.Key) && x.Value.Length == 0))
                    .Where(x => !Equals(x.Value, editing![x.Key])).ToDictionary(x => x.Key, x => x.Value);
                var original = editing!;
                await Task.Run(() => Session.Save(original, changes));
            }
            Cancel(); selected.Clear();
            message = inserting ? "Record added. Refresh or page through the table to locate the new record." : "Changes saved.";
            try { await Task.Run(() => Session.LoadPage(inserting ? 0 : Session.Page)); }
            catch (Exception ex) { message = (inserting ? "Record added" : "Changes saved") + ", but refresh failed. Refresh before editing again. " + ex; }
        }
        catch (Exception ex) { dialogError = ex.ToString(); }
        finally { Session.IsBusy = false; }
    }
    public async Task DeleteAsync()
    {
        if (Preview != null || Session.IsBusy || editing != null || !confirmDelete) return;
        Session.IsBusy = true;
        dialogError = "";
        try
        {
            var rows = selected.ToArray();
            await Task.Run(() => Session.Delete(rows));
            selected.Clear(); confirmDelete = false;
            message = $"Deleted {rows.Length} records.";
            try
            {
                await Task.Run(() => Session.LoadPage(Session.Page));
                if (Session.Data.Rows.Count == 0 && Session.Page > 0) await Task.Run(() => Session.LoadPage(Session.Page - 1));
            }
            catch (Exception ex) { message += " Refresh failed. Refresh before editing again. " + ex; }
        }
        catch (Exception ex) { dialogError = ex.ToString(); }
        finally { Session.IsBusy = false; }
    }
}

