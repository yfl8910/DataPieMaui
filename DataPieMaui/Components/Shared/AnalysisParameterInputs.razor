@using DataPieCore
<fieldset class="analysis-parameter-inputs" disabled="@Disabled">
    <legend>Parameters</legend>
    @foreach (var parameter in Config.Parameters)
    {
        var rule = Config.Groups.SelectMany(g => g.Rules).Concat(Config.CommonRules ?? Array.Empty<AnalysisFilterRule>()).FirstOrDefault(r => r.ParameterId == parameter.Id);
        if (rule == null) continue;
        <label>@parameter.Name @(parameter.Required ? "*" : "")
            <AnalysisFilterValues Kind="@(Fields.FirstOrDefault(f => f.Name == rule.Column)?.Kind ?? "Text")" Operation="@rule.Operation" Label="@parameter.Name"
                                  Values="@Current(parameter)" ValueChanged="v => Change(parameter.Id, v)" />
        </label>
    }
    <button type="button" @onclick="Reset">Reset parameters</button>
</fieldset>
@code {
    [Parameter, EditorRequired] public AnalysisFilterConfig Config { get; set; } = default!;
    [Parameter] public IReadOnlyList<AnalysisFilterField> Fields { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<string>> Values { get; set; } = new Dictionary<string, IReadOnlyList<string>>();
    [Parameter] public EventCallback<IReadOnlyDictionary<string, IReadOnlyList<string>>> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private IReadOnlyList<string> Current(AnalysisParameter p) => Values.TryGetValue(p.Id, out var value) ? value : AnalysisFilters.Defaults(p, DateTime.Today);
    private Task Change(string id, IReadOnlyList<string> value)
    {
        var next = Values.ToDictionary(p => p.Key, p => p.Value); next[id] = value.ToArray(); return ValueChanged.InvokeAsync(next);
    }
    private Task Reset() => ValueChanged.InvokeAsync(AnalysisFilters.Resolve(Config));
}
