@inherits LocalizedComponent
@using DataPieCore
<div class="analysis-number-format">
    <label>@L("Format", "应用格式")<select aria-label="@L("Number format", "数字格式")" value="@Current.Kind" @onchange="KindChanged"><option value="Auto">@L("Auto (legacy)", "自动（旧版）")</option><option value="Number">@L("Number", "数字")</option><option value="Percent">@L("Percent", "百分比")</option><option value="Currency">@L("Currency", "货币")</option></select></label>
    @if (Current.Kind != "Auto")
    {
        <label>@L("Decimals", "小数位数")<input aria-label="@L("Decimal places", "小数位数")" type="number" min="0" max="10" value="@Current.Decimals" @onchange="DecimalsChanged" /></label>
        <label><input type="checkbox" checked="@Current.Thousands" @onchange="ThousandsChanged" /> @L("Thousands", "千位分隔符")</label>
        @if (Current.Kind == "Currency") { <label>@L("Symbol", "符号")<input value="@Current.Symbol" maxlength="12" @oninput="SymbolChanged" /></label> }
    }
</div>
@code {
    [Parameter] public AnalysisNumberFormat? Value { get; set; }
    [Parameter] public EventCallback<AnalysisNumberFormat?> ValueChanged { get; set; }
    private AnalysisNumberFormat Current => Value ?? new();
    private Task KindChanged(ChangeEventArgs e) => Change(Current with { Kind = e.Value?.ToString() ?? "Auto" });
    private Task ThousandsChanged(ChangeEventArgs e) => Change(Current with { Thousands = e.Value is true });
    private Task SymbolChanged(ChangeEventArgs e) => Change(Current with { Symbol = e.Value?.ToString() ?? "" });
    private Task Change(AnalysisNumberFormat value) => ValueChanged.InvokeAsync(value.Kind == "Auto" ? null : value);
    private Task DecimalsChanged(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out int value) ? Change(Current with { Decimals = Math.Clamp(value, 0, 10) }) : Task.CompletedTask;
}
