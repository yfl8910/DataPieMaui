@using DataPieCore
<div class="modal-overlay">
    <section class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="group-dialog-title" tabindex="-1">
        <div class="dialog-header"><h2 id="group-dialog-title">Group by</h2><button data-dialog-close @onclick="OnCancel" aria-label="Close grouping settings">×</button></div>
        <div class="dialog-body">
            <p>Select fields in the desired grouping order. Leave empty for a total. Dates group by their original value.</p>
            <label>Search fields<input type="search" @bind="search" @bind:event="oninput" placeholder="Search field names" /></label>
            <div class="analysis-group-list">
                @foreach (var field in Source.Fields.Where(f => f.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
                {
                    <label title="@field.Notice"><input type="checkbox" checked="@draft.Contains(field.Name)" @onchange="e => Toggle(field.Name, e.Value is true)" disabled="@(!field.CanGroup)" /> <span>@field.Name <small>@field.Type @field.Notice</small></span></label>
                }
            </div>
            <h3>Selected order (@draft.Count)</h3>
            @foreach (var name in draft.ToArray())
            {
                <div class="analysis-selected"><span>@name</span><button @onclick="() => Move(name, -1)" disabled="@(draft.IndexOf(name) == 0)" aria-label="@($"Move {name} up")">↑</button><button @onclick="() => Move(name, 1)" disabled="@(draft.IndexOf(name) == draft.Count - 1)" aria-label="@($"Move {name} down")">↓</button><button @onclick="() => draft.Remove(name)" aria-label="@($"Remove {name}")">×</button></div>
            }
        </div>
        <div class="dialog-actions"><button @onclick="() => draft.Clear()">Clear selection</button><button @onclick="OnCancel">Cancel</button><button class="primary" @onclick="ApplyAsync">Apply</button></div>
    </section>
</div>
@code {
    [Parameter, EditorRequired] public TableAnalysis Source { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> Selected { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<string>> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private List<string> draft = [];
    private string search = "";
    public Task ApplyAsync() => OnApply.InvokeAsync(draft.ToArray());
    protected override void OnInitialized() => draft = Selected.ToList();
    public void Toggle(string name, bool value)
    {
        if (!Source.Fields.Any(f => f.Name == name && f.CanGroup)) return;
        if (value) { if (!draft.Contains(name)) draft.Add(name); } else draft.Remove(name);
    }
    private void Move(string name, int delta)
    {
        int index = draft.IndexOf(name), next = index + delta;
        if (index >= 0 && next >= 0 && next < draft.Count) (draft[index], draft[next]) = (draft[next], draft[index]);
    }
}
