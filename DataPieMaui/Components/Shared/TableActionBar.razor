@inherits LocalizedComponent
<div class="actions" aria-label="@L("Table actions", "表操作")">
    <button @onclick="OnImport">@L("Import file", "导入文件")</button>
    <button @onclick="OnExport">@L("Export Excel", "导出 Excel")</button>
    <button @onclick="OnEdit">@L("Query&Edit", "查询并编辑")</button>
    <button @onclick="OnAnalyze">@L("Data analysis", "数据分析")</button>
    <button class="danger" @onclick="OnClear">@L("Clear Data", "清空数据")</button>
    <button class="danger" @onclick="OnDrop">@L("DROP TABLE", "删除表")</button>
</div>

@code {
    [Parameter] public EventCallback OnImport { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnAnalyze { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnDrop { get; set; }
}
