@inherits LocalizedComponent
@inject IJSRuntime JS
<div class="schema-definition">
    <div class="actions">
        <h3>@L("SQL definition", "SQL 定义")</h3>
        <button @onclick="CopyAsync">@L("Copy SQL", "复制 SQL")</button>
        <span role="status">@message</span>
    </div>
    <pre tabindex="0" aria-label="@L("SQL definition", "SQL 定义")"><code>@Sql</code></pre>
</div>

@code {
    [Parameter, EditorRequired] public string Sql { get; set; } = "";
    private string message = "";
    private string? sourceSql;
    protected override void OnParametersSet()
    {
        if (sourceSql == Sql) return;
        sourceSql = Sql;
        message = "";
    }
    public async Task CopyAsync()
    {
        try { await JS.InvokeVoidAsync("dataPie.copyText", Sql); message = L("SQL copied.", "已复制 SQL。"); }
        catch { message = L("Copy failed. Select the SQL text and press Ctrl+C.", "复制失败。请选择 SQL 文本并按 Ctrl+C。"); }
    }
}
