@inherits LocalizedComponent
@using DataPieCore
<div class="@(Inline ? "advanced-search-inline-container" : "modal-overlay")">
    <section class="@(Inline ? "advanced-search-inline advanced-search-dialog" : "editor-dialog analysis-calculation-dialog advanced-search-dialog")" role="@(Inline ? "region" : "dialog")" aria-modal="@(Inline ? null : "true")" aria-label="@(Inline ? "Search conditions" : null)" aria-labelledby="@(Inline ? null : "filter-settings-title")" tabindex="@(Inline ? null : "-1")">
        @if (!Inline) {
        <div class="dialog-header"><h2 id="filter-settings-title">@Title</h2><button data-dialog-close @onclick="OnCancel" aria-label="Close filter settings">×</button></div>
        }
        <div class="@(Inline ? "advanced-search-inline-body" : "dialog-body")">
            <fieldset class="advanced-search-fields" disabled="@Disabled">
            <p>All conditions must match (AND).</p>
                <section class="advanced-search-conditions">
                    @foreach (var rule in rules)
                    {
                        <div class="analysis-filter-rule" @key="rule.Id">
                            <span>@(rules.IndexOf(rule) == 0 ? "" : "AND")</span>
                            <label>Field<select value="@rule.Column" @onchange="e => ChangeField(rule, e.Value?.ToString() ?? string.Empty)"><option value="">@L("All text fields", "所有文本字段")</option>@foreach (var field in AvailableFields) { <option value="@field.Name">@(string.IsNullOrEmpty(field.DisplayName) ? field.Name : field.DisplayName)</option> }</select></label>
                            <label>Operator<select value="@rule.Operation" @onchange="e => ChangeOperation(rule, e.Value?.ToString() ?? string.Empty)">@foreach (string operation in Choices(rule)) { <option value="@operation">@OperationName(operation)</option> }</select></label>
                            <button @onclick="() => rules.Remove(rule)" aria-label="@L("Remove condition", "移除条件")">×</button>
                            @if (rule.Operation is not ("IsNull" or "IsNotNull"))
                            {
                                <AnalysisFilterValues Kind="@Kind(rule)" Operation="@rule.Operation" Values="rule.Values" ValueChanged="v => ChangeValues(rule, v)" Label="@rule.Column" />
                                @if (rule.ReviewReason.Length > 0) { <p class="dialog-error" role="alert">@rule.ReviewReason</p> }
                            }
                        </div>
                    }
                    <button @onclick="AddRule">@L("Add condition", "添加条件")</button>
                </section>
            @if (error.Length > 0) { <p class="dialog-error" role="alert">@error</p> }
            @if (!string.IsNullOrEmpty(ExternalError)) { <p class="dialog-error" role="alert">@ExternalError</p> }
            </fieldset>
        </div>
        @if (ShowActions)
        {
        <div class="@(Inline ? "toolbar advanced-search-actions" : "dialog-actions")">
            @if (!Inline) { <button @onclick="OnCancel" disabled="@Disabled">@L("Cancel", "取消")</button> }
            <button class="primary" @onclick="ApplyAsync" disabled="@Disabled">@ApplyLabel</button>
            @if (Inline) { @if (ShowClear) { <button @onclick="OnClear" disabled="@Disabled">Clear search</button> } @Actions }
        </div>
        }
    </section>
</div>
@code {
    [Parameter] public TableAnalysis? Source { get; set; }
    [Parameter, EditorRequired] public AnalysisRequest Settings { get; set; } = default!;
    [Parameter] public IReadOnlyList<AnalysisFilterField>? Fields { get; set; }
    [Parameter] public string Title { get; set; } = "Advanced search";
    [Parameter] public Action<AnalysisFilterConfig>? Validate { get; set; }
    [Parameter] public string? ExternalError { get; set; }
    [Parameter] public bool Inline { get; set; }
    [Parameter] public bool ShowClear { get; set; } = true;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string ApplyLabel { get; set; } = "Apply";
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback<AnalysisFilterConfig> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private readonly List<Rule> rules = [];
    private IReadOnlyList<AnalysisFilterField> AvailableFields => Fields ?? Source?.FilterFields ?? [];
    private string error = "";
    private sealed class Rule { public string Id = Guid.NewGuid().ToString("N"), Column = "", Operation = "Contains", ReviewReason = ""; public List<string> Values = []; }
    protected override void OnInitialized()
    {
        var config = AnalysisFilters.ToFixedConditions(AnalysisFilters.MergeLegacy(Settings.Filters, Settings.Conditions, AvailableFields));
        rules.AddRange(config.Groups.SelectMany(g => g.Rules).Concat(config.CommonRules ?? []).Select(r => new Rule { Id = r.Id, Column = r.Column, Operation = r.Operation, ReviewReason = r.ReviewReason, Values = r.Values.ToList() }));
        if (rules.Count == 0) AddRule();
    }
    private string Kind(Rule rule) => AvailableFields.FirstOrDefault(f => f.Name == rule.Column)?.Kind ?? "Text";
    private IEnumerable<string> Choices(Rule rule) => string.IsNullOrEmpty(rule.Column) ? new[] { "Contains" } : AnalysisFilters.Operations.Where(o =>
        (o != "Contains" || Kind(rule) == "Text") && (o != "Range" || Kind(rule) is "Number" or "Date"));
    private static string OperationName(string op) => op switch { "Equals" => "Equals", "NotEquals" => "Not equal", "Contains" => "Contains", "Range" => "Range (inclusive)", "In" => "In multiple values", "IsNull" => "Is NULL", "IsNotNull" => "Is not NULL", "Greater" => ">", "GreaterOrEqual" => ">=", "Less" => "<", "LessOrEqual" => "<=", _ => op };
    private void ChangeField(Rule rule, string field) { rule.Column = field; rule.Operation = Kind(rule) == "Text" ? "Contains" : "Equals"; rule.Values = []; rule.ReviewReason = ""; }
    private void ChangeOperation(Rule rule, string operation) { rule.Operation = operation; rule.Values = []; rule.ReviewReason = ""; }
    private void AddRule() => rules.Add(new Rule());
    private void ChangeValues(Rule rule, IReadOnlyList<string> values) { rule.Values = values.ToList(); if (values.Count > 0 && values.All(v => !string.IsNullOrWhiteSpace(v))) rule.ReviewReason = ""; }
    public async Task ApplyAsync() => await TryApplyAsync();
    public async Task<bool> TryApplyAsync()
    {
        if (Disabled) return false;
        error = "";
        try
        {
            bool Active(Rule r) => !string.IsNullOrEmpty(r.ReviewReason) || r.Operation != "Contains" || r.Values.Any(v => !string.IsNullOrEmpty(v));
            var active = rules.Where(Active).Select(r => new AnalysisFilterRule(r.Id, r.Column, r.Operation, r.Values.ToArray(), ReviewReason: r.ReviewReason)).ToArray();
            var config = new AnalysisFilterConfig(active.Length == 0 ? Array.Empty<AnalysisFilterGroup>() : new[] { new AnalysisFilterGroup(active) }, Array.Empty<AnalysisParameter>());
            if (Validate != null) Validate(config); else Source?.ValidateRequest(Settings with { Filters = config, Conditions = null, ParameterValues = null });
            await OnApply.InvokeAsync(config);
            return true;
        }
        catch (ArgumentException ex) { error = ex.Message; StateHasChanged(); return false; }
    }
}
