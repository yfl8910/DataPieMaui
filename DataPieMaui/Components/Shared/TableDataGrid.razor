@typeparam TRow
<div class="table-scroll" tabindex="0" aria-label="Table data">
    <table>
        <thead><tr>
            @if (ShowLeadingColumn) { <th>@LeadingHeader</th> }
            @for (int c = 0; c < ColumnCount; c++)
            {
                <th aria-sort="@(SortState?.Invoke(c))">@ColumnHeader(c)</th>
            }
        </tr></thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr class="@(IsSelected(row) ? "selected" : "")" tabindex="@(SelectRows ? 0 : (int?)null)" aria-selected="@(SelectRows ? IsSelected(row) : (bool?)null)" @onclick="() => SelectAsync(row)" @onkeydown="e => SelectWithKeyAsync(e, row)">
                    @if (ShowLeadingColumn) { <td>@LeadingCell(row)</td> }
                    @for (int c = 0; c < ColumnCount; c++)
                    {
                        var text = CellText(row, c);
                        <td class="@(CellIsNull(row, c) ? "null" : "")" title="@text">@text</td>
                    }
                </tr>
            }
            @if (!Rows.Any()) { <tr><td colspan="@(ColumnCount + (ShowLeadingColumn ? 1 : 0))" class="empty">@EmptyText</td></tr> }
        </tbody>
        @if (ShowFooter && Footer != null) { <tfoot>@Footer</tfoot> }
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<TRow> Rows { get; set; } = [];
    [Parameter] public int ColumnCount { get; set; }
    [Parameter] public bool ShowLeadingColumn { get; set; } = true;
    [Parameter, EditorRequired] public RenderFragment<int> ColumnHeader { get; set; } = default!;
    [Parameter] public RenderFragment? LeadingHeader { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TRow> LeadingCell { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TRow, int, string> CellText { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TRow, int, bool> CellIsNull { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TRow, bool> IsSelected { get; set; } = default!;
    [Parameter] public Func<int, string>? SortState { get; set; }
    [Parameter] public bool SelectRows { get; set; }
    [Parameter] public EventCallback<TRow> OnSelect { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No records.";
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool ShowFooter { get; set; } = true;
    private Task SelectAsync(TRow row) => SelectRows ? OnSelect.InvokeAsync(row) : Task.CompletedTask;
    private Task SelectWithKeyAsync(KeyboardEventArgs e, TRow row) => e.Key is "Enter" or " " ? SelectAsync(row) : Task.CompletedTask;
}
