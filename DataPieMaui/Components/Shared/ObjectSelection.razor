<div class="object-list" role="group" aria-label="@Label">
    @if (Items.Count == 0) { <p class="empty">No @Label.ToLowerInvariant() available in this database.</p> }
    @foreach (var item in Items)
    {
        <div class="object-row" @key="item">
            <label class="object-choice">@if (AllowSelection) { <input type="checkbox" @bind="item.Selected" @bind:after="NotifySelectionChanged" /> }<span class="type-badge">@item.Kind</span><span>@item.DisplayName</span></label>
            @if (OnDefinition.HasDelegate && item.DefinitionObject is not null)
            {
                <button aria-label="@($"View definition: {item.DisplayName}")" @onclick="() => OnDefinition.InvokeAsync(item)">View definition</button>
            }
            @if (OnPreviewItem.HasDelegate)
            {
                <button class="object-preview" aria-label="@($"Query data: {item.DisplayName}")" @onclick="() => OnPreviewItem.InvokeAsync(item)">Query data</button>
            }
            else if (OnPreview.HasDelegate)
            {
                <button class="object-preview" aria-label="@($"Query data: {item.Name}")" @onclick="() => OnPreview.InvokeAsync(item.Name)">Query data</button>
            }
            @if (OnRunParameters.HasDelegate)
            {
                <button @onclick="() => OnRunParameters.InvokeAsync(item)">Run with parameters</button>
            }
        </div>
    }
</div>
@code {
    [Parameter, EditorRequired] public List<SelectableObject> Items { get; set; } = [];
    [Parameter] public string Label { get; set; } = "Objects";
    [Parameter] public bool AllowSelection { get; set; } = true;
    [Parameter] public EventCallback OnSelectionChanged { get; set; }
    private Task NotifySelectionChanged() => OnSelectionChanged.InvokeAsync();
    [Parameter] public EventCallback<string> OnPreview { get; set; }
    [Parameter] public EventCallback<SelectableObject> OnPreviewItem { get; set; }
    [Parameter] public EventCallback<SelectableObject> OnDefinition { get; set; }
    [Parameter] public EventCallback<SelectableObject> OnRunParameters { get; set; }
}
