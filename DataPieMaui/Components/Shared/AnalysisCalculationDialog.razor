@inherits LocalizedComponent
@using DataPieCore
@using DataPieMaui.Services.Shared
<div class="modal-overlay">
    <section class="editor-dialog analysis-calculation-dialog" role="dialog" aria-modal="true" aria-labelledby="calculation-dialog-title" tabindex="-1">
        <div class="dialog-header"><h2 id="calculation-dialog-title">@L("Calculations", "计算项")</h2><button data-dialog-close @onclick="OnCancel" aria-label="@L("Close calculation settings", "关闭计算设置")">×</button></div>
        <div class="dialog-body">
            <label><input type="checkbox" @bind="includeCount" /> @L("Record count", "记录数")</label>
            @if (includeCount) { <AnalysisNumberFormatInput @bind-Value="countFormat" /> }
            <h3>@L("Aggregates", "聚合项")</h3><p>@L("Add numeric aggregates and optionally give each a name. Click ↑ to move an aggregate up. Apply saves the column order.", "添加数值聚合项，可为每项命名。点击 ↑ 上移。应用后会保存列顺序。")</p>
            @foreach (var item in aggregates)
            {
                <div class="analysis-calculation-row" @key="item.Id">
                    <button type="button" class="aggregate-move-up" aria-label="@("Move up " + item.ToCalculation().DisplayName)" title="@L("Move up", "上移")" disabled="@(aggregates[0].Id == item.Id)" @onclick="() => MoveAggregateUp(item.Id)">↑</button>
                    <label>@L("Field", "字段")<select @bind="item.Column">@foreach (var column in Source.NumericColumns) { <option value="@column">@column</option> }</select></label>
                    <label>@L("Calculation", "计算方式")<select @bind="item.Operation"><option value="SUM">@L("Sum", "求和")</option><option value="AVG">@L("Average", "平均值")</option><option value="MIN">@L("Min", "最小值")</option><option value="MAX">@L("Max", "最大值")</option></select></label>
                    <label>@L("Result name", "结果名称")<input @bind="item.Name" @bind:event="oninput" maxlength="110" placeholder="@item.ToCalculation().DisplayName" /></label>
                    <AnalysisNumberFormatInput @bind-Value="item.Format" />
                    <button @onclick="() => RemoveAggregate(item.Id)" aria-label="@L("Remove aggregate", "移除聚合项")">×</button>
                </div>
            }
            <button @onclick="AddAggregate" disabled="@(Source.NumericColumns.Count == 0)">@L("Add aggregate", "添加聚合项")</button>
            <h3>@L("Aggregate formulas", "聚合公式")</h3><p>@L("Example: Total revenue ÷ Total quantity. Formulas use the group totals, not individual-row prices. Division by zero or NULL returns NULL.", "例如：总收入 ÷ 总数量。公式使用各组的聚合值。除数为零或 NULL 时返回 NULL。")</p>
            @foreach (var formula in formulas)
            {
                <div class="analysis-formula-row" @key="formula">
                    <label>@L("Result name", "结果名称")<input @bind="formula.Name" @bind:event="oninput" maxlength="110" placeholder="@L("Average price", "平均价格")" /></label>
                    <AnalysisNumberFormatInput @bind-Value="formula.Format" />
                    <label>@L("Left aggregate", "左侧聚合项")<select @key="AggregateOptionsKey" aria-label="@("Left aggregate " + formula.Name)" value="@formula.Left" @onchange="e => ChangeAggregateReference(formula, false, e)"><option value="">@L("Select aggregate", "选择聚合项")</option>@foreach (var item in aggregates) { <option value="@item.Id">@item.ToCalculation().DisplayName</option> }</select></label>
                    <label>@L("Operator", "运算符")<select @bind="formula.Operation"><option value="+">＋</option><option value="-">－</option><option value="*">×</option><option value="/">÷</option></select></label>
                    <label>@L("Right value", "右侧值")<select aria-label="@("Right value " + formula.Name)" value="@(formula.UseConstant ? "constant" : "aggregate")" @onchange="e => ChangeRightValue(formula, e)"><option value="aggregate">@L("Aggregate", "聚合项")</option><option value="constant">@L("Constant", "常量")</option></select></label>
                    @if (formula.UseConstant) { <label @key='"constant"'>@L("Constant", "常量")<input aria-label="@("Constant " + formula.Name)" type="number" step="any" @bind="formula.Constant" /></label> }
                    else { <label @key='"aggregate"'>@L("Right aggregate", "右侧聚合项")<select @key="AggregateOptionsKey" aria-label="@("Right aggregate " + formula.Name)" value="@formula.Right" @onchange="e => ChangeAggregateReference(formula, true, e)"><option value="">@L("Select aggregate", "选择聚合项")</option>@foreach (var item in aggregates) { <option value="@item.Id">@item.ToCalculation().DisplayName</option> }</select></label> }
                    <button @onclick="() => formulas.Remove(formula)" aria-label="@L("Remove formula", "移除公式")">×</button>
                </div>
            }
            <button @onclick="AddFormula" disabled="@(aggregates.Count == 0)">@L("Add formula", "添加公式")</button>
            <h3>@L("Default sort", "默认排序")</h3>
            <div class="analysis-calculation-row">
                <label>@L("Sort by", "排序字段")<select @key="AggregateOptionsKey" aria-label="@L("Sort by", "排序字段")" value="@sortBy" @onchange="ChangeSortBy"><option value="">@L("No default sort", "无默认排序")</option>
                    @foreach (var item in aggregates) { <option value="@("aggregate:" + item.Id)">@item.ToCalculation().DisplayName</option> }
                    @if (includeCount) { <option value="count">@L("Record count", "记录数")</option> }
                    @foreach (var item in formulas) { <option value="@("formula:" + (string.IsNullOrEmpty(item.Id) ? item.Name.Trim() : item.Id))">@item.Name</option> }
                </select></label>
                <label>@L("Direction", "排序方向")<select aria-label="@L("Direction", "排序方向")" value="@(sortDescending ? "desc" : "asc")" @onchange="ChangeSortDirection"><option value="asc">@L("Ascending", "升序")</option><option value="desc">@L("Descending", "降序")</option></select></label>
            </div>
            @if (error.Length > 0) { <div class="dialog-error" role="alert">@error</div> }
        </div>
        <div class="dialog-actions"><button @onclick="OnCancel">@L("Cancel", "取消")</button><button class="primary" @onclick="ApplyAsync">@L("Apply", "应用")</button></div>
    </section>
</div>
@code {
    [Parameter, EditorRequired] public TableAnalysis Source { get; set; } = default!;
    [Parameter, EditorRequired] public AnalysisRequest Settings { get; set; } = default!;
    [Parameter] public EventCallback<AnalysisCalculationSettings> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private readonly List<AnalysisCalculationDraft> aggregates = [];
    private readonly List<AnalysisFormulaDraft> formulas = [];
    private bool includeCount;
    private string sortBy = "";
    private bool sortDescending;
    private string error = "";
    private AnalysisNumberFormat? countFormat;
    private string AggregateOptionsKey => string.Join("|", aggregates.Select(a => a.Id));
    public void MoveAggregateUp(string id)
    {
        int index = aggregates.FindIndex(a => a.Id == id);
        if (index <= 0) return;
        (aggregates[index - 1], aggregates[index]) = (aggregates[index], aggregates[index - 1]);
    }
    public void RemoveAggregate(string id)
    {
        aggregates.RemoveAll(a => a.Id == id);
        foreach (var formula in formulas) { if (formula.Left == id) formula.Left = ""; if (formula.Right == id) formula.Right = ""; }
        if (sortBy == "aggregate:" + id) sortBy = "";
    }
    private void ChangeRightValue(AnalysisFormulaDraft formula, ChangeEventArgs args)
    {
        formula.UseConstant = args.Value?.ToString() == "constant";
        if (!aggregates.Any(a => a.Id == formula.Right)) formula.Right = "";
        error = "";
    }
    private void ChangeAggregateReference(AnalysisFormulaDraft formula, bool right, ChangeEventArgs args)
    {
        string value = args.Value?.ToString() ?? "";
        if (!aggregates.Any(a => a.Id == value)) value = "";
        if (right) formula.Right = value; else formula.Left = value;
        error = "";
    }
    public void ChangeSortBy(ChangeEventArgs args) { sortBy = args.Value?.ToString() ?? ""; error = ""; }
    public void ChangeSortDirection(ChangeEventArgs args) { sortDescending = args.Value?.ToString() == "desc"; error = ""; }
    protected override void OnInitialized()
    {
        includeCount = Settings.IncludeCount;
        countFormat = Settings.CountFormat;
        sortBy = Settings.SortBy ?? ""; sortDescending = Settings.SortDescending;
        aggregates.AddRange(Settings.Calculations.Select(c => new AnalysisCalculationDraft { Column = c.Column, Operation = c.Operation, Name = c.Name, Id = c.Key, Format = c.Format }));
        formulas.AddRange((Settings.Formulas ?? []).Select(f => new AnalysisFormulaDraft { Id = f.Key, Format = f.Format, Name = f.Name, Left = f.Left, Operation = f.Operation, Right = f.Right, UseConstant = f.Constant.HasValue, Constant = f.Constant }));
    }
    public void AddAggregate()
    {
        var choices = Source.NumericColumns.SelectMany(c => new[] { "SUM", "AVG", "MIN", "MAX" }.Select(o => (Column: c, Operation: o)));
        var next = choices.FirstOrDefault(c => !aggregates.Any(a => a.Column == c.Column && a.Operation == c.Operation));
        if (next.Column != null) aggregates.Add(new() { Column = next.Column, Operation = next.Operation });
    }
    public void AddFormula()
    {
        if (aggregates.Count > 0) formulas.Add(new() { Id = Guid.NewGuid().ToString("N"), Name = "Formula " + (formulas.Count + 1), Left = aggregates[0].Id, Right = aggregates.Last().Id });
    }
    public async Task ApplyAsync()
    {
        try
        {
            if (formulas.Any(f => f.UseConstant && !f.Constant.HasValue)) throw new ArgumentException("Enter a numeric constant.");
            var result = new AnalysisCalculationSettings(aggregates.Select(a => a.ToCalculation()).ToArray(), includeCount, formulas.Select(f => f.ToFormula()).ToArray(), sortBy, sortDescending, countFormat);
            Source.ValidateRequest(Settings with { Calculations = result.Calculations, IncludeCount = result.IncludeCount, Formulas = result.Formulas, SortBy = result.SortBy, SortDescending = result.SortDescending, CountFormat = countFormat });
            await OnApply.InvokeAsync(result);
        }
        catch (ArgumentException ex) { error = ex.Message; }
    }
}
