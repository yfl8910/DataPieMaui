@implements IDisposable

<div class="workspace-shell">
    <div class="workspace-body" inert="@(Controller.Context.Dialogs.Current is not null)">
        <aside class="sidebar">
            <div class="brand"><span class="brand-icon">D</span><div>DataPie V3.0.0<span>DATABASE WORKSPACE</span></div></div>
            <nav aria-label="Workspace sections">
                @foreach (var item in navigation)
                {
                    bool enabled = item.Id is "Connections" or "About" || Controller.Context.State.IsConnected;
                    <button class="nav-item @(Controller.Context.Section == item.Id ? "active" : "")" disabled="@(!enabled || Controller.Context.State.Busy)" aria-current="@(Controller.Context.Section == item.Id ? "page" : null)" @onclick="() => Controller.Navigate(item.Id)"><span class="nav-symbol" aria-hidden="true">
                        @if (item.Id == "TableDesign")
                        {
                            <svg class="nav-table-design-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                                <path d="M11 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5M2 8h18M2 14h9M8 8v12" />
                                <path d="m13 17 6.5-6.5a1.4 1.4 0 0 1 2 2L15 19l-3 1 1-3Zm5-5 2 2" />
                            </svg>
                        }
                        else { @item.Icon }
                    </span>@item.Label</button>
                }
            </nav>
            <div class="sidebar-note">Local desktop workspace<br />SQL Server &amp; SQLite</div>
        </aside>
        <div class="workspace-main">
            <header class="topbar"><span>Workspace / <strong>@Title</strong></span><span class="connection-pill"><i class="@(Controller.Context.State.IsConnected ? "connected" : "")"></i>@Controller.Context.State.Connection</span></header>
            <main class="page-content">
                <div class="page-heading"><p>@Description</p></div>
                <CascadingValue Value="Controller" IsFixed="true">
                    <ErrorBoundary @ref="boundary">
                        <ChildContent>
                            <fieldset class="page-fields" disabled="@Controller.Context.State.Busy">
                                @switch (Controller.Context.Section)
                                {
                                    case "Connections": <ConnectionsPage /> break;
                                    case "Query": <QueryPage /> break;
                                    case "TableDesign": <TableDesignPage /> break;
                                    case "TableEdit": <TableEditPage /> break;
                                    case "Import": <ImportPage /> break;
                                    case "Export": <ExportPage /> break;
                                    case "Procedures": <ProceduresPage /> break;
                                    case "Migration": <MigrationPage /> break;
                                    case "About": <AboutPage /> break;
                                }
                            </fieldset>
                        </ChildContent>
                        <ErrorContent><div class="callout danger">The page could not be displayed. <button @onclick="Recover">Reload page</button></div></ErrorContent>
                    </ErrorBoundary>
                </CascadingValue>
            </main>
        </div>
        <footer class="statusbar" aria-live="polite">
            <span class="status-dot @(Controller.Context.State.Busy ? "working" : "")"></span>
            <span class="status-text">@Controller.Context.State.Status</span>
            @if (Controller.Context.State.Converting) { <button class="danger" @onclick="Controller.Conversion.CancelConversion">Cancel conversion</button> }
        </footer>
    </div>
    <WorkspaceDialogView Dialogs="Controller.Context.Dialogs" />
</div>

@code {
    [Parameter, EditorRequired] public WorkspaceController Controller { get; set; } = default!;
    private bool disposed;
    private ErrorBoundary? boundary;
    private readonly (string Id, string Label, string Icon, string Description)[] navigation =
    [
        ("Connections", "Database connection", "◎", "Connect to a database or manage your saved connections."),
        ("Query", "SQL query", "⌘", "Write SQL, preview results, and export your data."),
        ("Import", "Import data", "↓", "Bring files into an existing database table."),
        ("Export", "Batch export", "↑", "Export selected tables and views to Excel or CSV."),
        ("Procedures", "Stored procedures", "▷", "Run selected procedures in sequence."),
        ("Migration", "Database migration", "⇄", "Convert SQL Server to SQLite or generate SQL Server scripts from SQLite."),
        ("TableDesign", "Table design", "", "Create table structure from Excel or drop a table."),
        ("TableEdit", "Table Edit", "✎", "Select a table to open its data editor."),
        ("About", "About", "ⓘ", "A local workspace for your database tasks.")
    ];
    private string Title => navigation.First(x => x.Id == Controller.Context.Section).Label;
    private string Description => navigation.First(x => x.Id == Controller.Context.Section).Description;
    protected override void OnInitialized()
    {
        Controller.Changed += Refresh;

    }
    private void Refresh() => _ = InvokeAsync(() => { if (!disposed) StateHasChanged(); });
    private void Recover() => boundary?.Recover();
    public void Dispose() { disposed = true; Controller.Changed -= Refresh; }
}
