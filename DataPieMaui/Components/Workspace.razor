@implements IDisposable

<CascadingValue Name="UiLanguage" Value="language">
<div class="workspace-shell" lang="@language">
    <div class="workspace-body" inert="@(Controller.Context.Dialogs.Current is not null)">
        <aside class="sidebar">
            <div class="brand"><span class="brand-icon">D</span><div>DataPie V3.0.0<span>@L("DATABASE WORKSPACE", "数据库工作台")</span></div></div>
            <nav aria-label="@L("Workspace sections", "工作台导航")">
                @foreach (var item in navigation)
                {
                    bool enabled = item.Id is "Connections" or "About" || Controller.Context.State.IsConnected;
                    <button class="nav-item @(Controller.Context.Section == item.Id ? "active" : "")" disabled="@(!enabled || Controller.Context.State.Busy)" aria-current="@(Controller.Context.Section == item.Id ? "page" : null)" @onclick="() => Controller.Navigate(item.Id)"><span class="nav-symbol" aria-hidden="true">
                        @if (item.Id == "TableDesign")
                        {
                            <svg class="nav-table-design-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                                <path d="M11 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5M2 8h18M2 14h9M8 8v12" />
                                <path d="m13 17 6.5-6.5a1.4 1.4 0 0 1 2 2L15 19l-3 1 1-3Zm5-5 2 2" />
                            </svg>
                        }
                        else { @item.Icon }
                    </span>@L(item.Label, item.ChineseLabel)</button>
                }
            </nav>
            <div class="sidebar-note">@L("Local desktop workspace", "本地桌面工作台")<br />SQL Server &amp; SQLite</div>
        </aside>
        <div class="workspace-main">
            <header class="topbar">
                <span>@L("Workspace", "工作台") / <strong>@Title</strong></span>
                <span class="connection-pill"><i class="@(Controller.Context.State.IsConnected ? "connected" : "")"></i>@(Controller.Context.State.IsConnected ? Controller.Context.State.Connection : L("Not connected", "未连接"))</span>
                <select class="language-picker" aria-label="@L("Language", "界面语言")" value="@language" @onchange="ChangeLanguage" disabled="@Controller.Context.State.Busy">
                    <option value="en" lang="en">English</option>
                    <option value="zh-CN" lang="zh-CN">简体中文</option>
                </select>
            </header>
            <main class="page-content">
                <div class="page-heading"><p>@Description</p></div>
                <CascadingValue Value="Controller" IsFixed="true">
                    <ErrorBoundary @ref="boundary">
                        <ChildContent>
                            <fieldset class="page-fields" disabled="@Controller.Context.State.Busy">
                                @switch (Controller.Context.Section)
                                {
                                    case "Connections": <ConnectionsPage /> break;
                                    case "Query": <QueryPage /> break;
                                    case "TableDesign": <TableDesignPage /> break;
                                    case "DatabaseSchema": <DatabaseSchemaView /> break;
                                    case "Import": <ImportPage /> break;
                                    case "Export": <ExportPage /> break;
                                    case "Procedures": <ProceduresPage /> break;
                                    case "Migration": <MigrationPage /> break;
                                    case "About": <AboutPage /> break;
                                }
                            </fieldset>
                        </ChildContent>
                        <ErrorContent><div class="callout danger">@L("The page could not be displayed.", "无法显示此页面。") <button @onclick="Recover">@L("Reload page", "重新加载页面")</button></div></ErrorContent>
                    </ErrorBoundary>
                </CascadingValue>
            </main>
        </div>
        <footer class="statusbar" aria-live="polite">
            <span class="status-dot @(Controller.Context.State.Busy ? "working" : "")"></span>
            <span class="status-text">@(Controller.Context.State.Status == "Select or create a database connection." ? L("Select or create a database connection.", "请选择或创建数据库连接。") : Controller.Context.State.Status)</span>
            @if (Controller.Context.State.Converting) { <button class="danger" @onclick="Controller.Conversion.CancelConversion">@L("Cancel conversion", "取消转换")</button> }
        </footer>
    </div>
    <WorkspaceDialogView Dialogs="Controller.Context.Dialogs" />
</div>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public WorkspaceController Controller { get; set; } = default!;
    [Parameter] public string InitialLanguage { get; set; } = "en";
    [Parameter] public Action<string>? SaveLanguage { get; set; }
    private string language = "en";
    private bool disposed;
    private ErrorBoundary? boundary;
    private readonly (string Id, string Label, string ChineseLabel, string Icon, string Description, string ChineseDescription)[] navigation =
    [
        ("Connections", "Database connection", "数据库连接", "◎", "Connect to a database or manage your saved connections.", "连接数据库或管理已保存的连接。"),
        ("DatabaseSchema", "Database schema", "数据库结构", "▤", "Browse tables, views, procedures and column information.", "浏览表、视图、存储过程和字段信息。"),
        ("Query", "SQL query", "SQL 查询", "⌘", "Write SQL, preview results, and export your data.", "编写 SQL、预览查询结果并导出数据。"),
        ("Import", "Import data", "导入数据", "↓", "Bring files into an existing database table.", "将文件导入现有数据库表。"),
        ("Export", "Batch export", "批量导出", "↑", "Export selected tables and views to Excel or CSV.", "将选中的表和视图导出为 Excel 或 CSV。"),
        ("Procedures", "Stored procedures", "存储过程", "▷", "Run selected procedures in sequence.", "按顺序运行选中的存储过程。"),
        ("Migration", "Database migration", "数据库迁移", "⇄", "Convert SQL Server to SQLite or generate SQL Server object scripts from the connected database.", "将 SQL Server 转换为 SQLite，或为当前数据库生成 SQL Server 对象脚本。"),
        ("TableDesign", "Table design", "表设计", "", "Create table structure from Excel or drop a table.", "根据 Excel 创建表结构，或删除表。"),
        ("About", "About", "关于", "ⓘ", "A local workspace for your database tasks.", "在本地桌面上处理数据库任务。")
    ];
    private string Title => L(navigation.First(x => x.Id == Controller.Context.Section).Label, navigation.First(x => x.Id == Controller.Context.Section).ChineseLabel);
    private string Description => L(navigation.First(x => x.Id == Controller.Context.Section).Description, navigation.First(x => x.Id == Controller.Context.Section).ChineseDescription);
    private string L(string english, string chinese) => language == "zh-CN" ? chinese : english;
    private void ChangeLanguage(ChangeEventArgs args)
    {
        if (args.Value is not string value || value is not ("en" or "zh-CN") || language == value) return;
        language = value;
        SaveLanguage?.Invoke(value);
    }
    protected override void OnInitialized()
    {
        language = InitialLanguage == "zh-CN" ? "zh-CN" : "en";
        Controller.Changed += Refresh;
    }
    private void Refresh() => _ = InvokeAsync(() => { if (!disposed) StateHasChanged(); });
    private void Recover() => boundary?.Recover();
    public void Dispose() { disposed = true; Controller.Changed -= Refresh; }
}
