@inherits LocalizedComponent
@using DataPieCore
@using DataPieMaui.Services.Shared
@inject IJSRuntime JS
<CascadingValue Name="UiLanguage" Value="CurrentLanguage">
<div lang="@CurrentLanguage" style="display: contents">
<main class="analysis-page" inert="@(settingsDialog.Length > 0)">
    @{ bool matchesResult = Session.Result != null && Session.Matches(Request); }
    <header><div><h1>@L("Data analysis", "数据分析")</h1><p>@Session.ConnectionLabel · @Session.Source.TableName</p></div><span class="badge">@(Session.Busy ? L("Working…", "处理中…") : L("Read-only", "只读"))</span></header>
    <div class="analysis-settings-scroll" tabindex="0" aria-label="@L("Analysis settings", "分析设置")">
    <fieldset class="analysis-settings" disabled="@Session.Busy">
        @if (Session.TemplatesEnabled)
        {
            <div class="analysis-template-bar">
                <select aria-label="@L("Template", "模板")" @bind="selectedTemplateId" @bind:after="TemplateSelectionChangedAsync"><option value="0">@L("Select a template", "选择模板")</option>@foreach (var template in Session.Templates) { <option value="@template.Id">@template.Name</option> }</select>
                <button @onclick="() => ApplyTemplateAsync(selectedTemplateId)" disabled="@(selectedTemplateId == 0)">@L("Apply template", "应用模板")</button>
                <button @onclick="SaveCurrentTemplateAsync">@L("Save", "保存")</button>
                <button @onclick="OpenTemplateManager">@L("Manage templates", "管理模板")</button>
                <button @onclick="NewTemplateAsync">@L("New template", "新建模板")</button>
            </div>
            @if (isNewTemplateDraft) { <p class="notice">@L("New template, not saved. Adjust settings and click Save to enter a new name.", "新模板尚未保存。调整设置后点击“保存”并输入名称。")</p> }
        }
        <div class="analysis-config-bar">
            <button @onclick="OpenGroupSettings">@L("Group by", "分组字段") (@groups.Count)</button>
            <span title="@string.Join(", ", groups)">@(groups.Count == 0 ? L("Total (no grouping)", "合计（不分组）") : string.Join(", ", groups))</span>
            <button @onclick="OpenCalculationSettings">@L("Calculations", "计算项") (@(calculations.Count + formulas.Count + (includeCount ? 1 : 0)))</button>
            <span title="@CalculationSummary">@CalculationSummary</span>
            @if (templateConditions.Count > 0 || templateFilters != null)
            {
                <div class="analysis-default-filters"><strong>@L("Default filters (saved)", "已保存的默认筛选条件")</strong><span>@DefaultFilterSummary</span></div>
            }
        </div>
        <SimpleSearch Fields="SearchFields" Value="conditions" ValueChanged="SetConditions" OnSearch="AnalyzeConditionsAsync" OnClear="ClearAllFiltersAsync" Disabled="Session.Busy" AllowAllText="true" SearchLabel="@L("Analyze", "分析")">
            <Actions><button type="button" @onclick="OpenFilterSettings">@L("Advanced search", "高级搜索")</button><button type="button" @onclick="Reset">@L("Reset", "重置")</button><label><input type="checkbox" @bind="exportFormatted" /> @L("Format", "应用格式")</label><button type="button" @onclick="ExportAsync" disabled="@(!matchesResult)">@L("Export", "导出")</button></Actions>
        </SimpleSearch>

        @if (filters != null && (filters.Groups.Any(g => g.Rules.Count > 0) || filters.CommonRules?.Count > 0)) { <p>@L("Advanced filters:", "高级筛选：") @FilterSummary(filters)</p> }
        <p>@L("Analysis includes all matching source rows. NULL values are ignored by numeric calculations. Export reruns the same analysis against the current source data.", "分析覆盖所有匹配的源数据。数值计算会忽略 NULL。导出会用当前源数据重新运行分析。")</p>
        @if (Session.Source.Provider == "SQLITE") { <p>@L("SQLite uses native numeric precision; nonnumeric values in calculation fields are rejected.", "SQLite 使用原生数值精度。计算字段必须为数值或 NULL。")</p> }
    </fieldset>
    </div>
    @if (Session.Result is { } result)
    {
        @if (!matchesResult) { <p class="notice">@L("Settings changed. Analyze again to update these results.", "设置已更改，请重新分析以更新结果。")</p> }
        @if (result.Truncated) { <p class="notice">@L("Showing the first 1,000 groups. Calculations include the full matching source. Export Excel retrieves all groups.", "当前显示前 1,000 个分组，计算覆盖所有匹配数据。导出 Excel 可获取全部分组。")</p> }
        <TableDataGrid TRow="int" Rows="@order.Skip(page * 100).Take(100)" ColumnCount="result.ColumnCount" CellText="result.FormatGroupedCell" CellIsNull="result.IsNull"
                       IsSelected="IsSelected" SelectRows="true" OnSelect="Select" SortState="SortState" ShowFooter="@(Session.Totals != null && matchesResult)">
            <LeadingHeader>#</LeadingHeader>
            <ColumnHeader Context="column"><button @onclick="() => Sort(column)">@result.GetColumnName(column) @(sortColumn == column ? (descending ? "▼" : "▲") : "")</button></ColumnHeader>
            <LeadingCell Context="index">@(index + 1)</LeadingCell>
            <Footer>
                @if (Session.Totals is { } totals && Session.LastRequest is { } analyzed)
                {
                    <tr class="analysis-total-row"><th scope="row" title="@L("Overall totals for all matching source rows, including groups outside this preview", "所有匹配源数据的合计，包括预览范围之外的分组")">@L("Total", "合计")</th>
                        @for (int column = 0; column < result.ColumnCount; column++)
                        {
                            if (column < analyzed.Groups.Count) { <td></td> }
                            else
                            {
                                int totalColumn = column - analyzed.Groups.Count;
                                string text = totals.FormatGroupedCell(0, totalColumn);
                                <td class="@(totals.IsNull(0, totalColumn) ? "null" : "")" title="@text">@text</td>
                            }
                        }
                    </tr>
                }
            </Footer>
        </TableDataGrid>
        <div class="toolbar"><button @onclick="() => CopyAsync(false)" disabled="@(selected == null)">@L("Copy selected row", "复制选中行")</button><button @onclick="() => CopyAsync(true)">@L("Copy preview rows", "复制预览行")</button>
            <div class="pagination"><button @onclick="() => page--" disabled="@(page == 0)">@L("Previous", "上一页")</button><span>@L($"Page {page + 1}/{PageCount} · {result.RowCount} groups", $"第 {page + 1}/{PageCount} 页 · {result.RowCount} 个分组")</span><button @onclick="() => page++" disabled="@(page + 1 >= PageCount)">@L("Next", "下一页")</button></div>
        </div>
    }
    else { <div class="empty">@L("Choose fields and click Analyze to view grouped results.", "选择字段并点击“分析”，即可查看分组结果。")</div> }
    <footer><span role="status" style="white-space:pre-wrap">@(clipboardMessage.Length > 0 ? clipboardMessage : L(Session.Status, Session.ChineseStatus))</span></footer>
</main>
@if (settingsDialog == "groups")
{
    <AnalysisGroupDialog Source="Session.Source" Selected="groups" OnApply="ApplyGroups" OnCancel="CloseSettings" />
}
else if (settingsDialog == "calculations")
{
    <AnalysisCalculationDialog Source="Session.Source" Settings="Request" OnApply="ApplyCalculations" OnCancel="CloseSettings" />
}
else if (settingsDialog == "filters")
{
    <AdvancedSearch Source="Session.Source" Settings="Request" Disabled="Session.Busy" OnApply="SearchAdvancedAsync" OnCancel="CloseSettings" />
}
else if (settingsDialog == "templates")
{
    <AnalysisTemplateDialog Session="Session" SelectedId="selectedTemplateId" SelectedIdChanged="TemplateSelected" OnClose="CloseSettings" />
}
else if (settingsDialog == "save-template")
{
    <div class="modal-overlay"><section class="editor-dialog" role="dialog" aria-modal="true" aria-labelledby="save-template-title" tabindex="-1">
        <div class="dialog-header"><h2 id="save-template-title">@L("Save template", "保存模板")</h2><button data-dialog-close @onclick="CloseSettings" disabled="@Session.Busy" aria-label="@L("Cancel saving template", "取消保存模板")">×</button></div>
        <form @onsubmit="SaveNewTemplateAsync" @onsubmit:preventDefault>
            <fieldset class="dialog-body" disabled="@Session.Busy">
                <label>@L("Template name", "模板名称")<input @bind="NewTemplateName" @bind:event="oninput" maxlength="100" autofocus /></label>
                <p>@L("Saves current Group by, Calculations, default sort and nonempty search conditions.", "保存当前的分组、计算项、默认排序和非空搜索条件。") @(isNewTemplateDraft ? L("Enter a different name to create a new template.", "请输入其他名称以创建新模板。") : L("The same table and name replaces the existing template.", "同一表下的同名模板会被替换。"))</p>
                <p role="status" style="white-space:pre-wrap">@L(Session.Status, Session.ChineseStatus)</p>
            </fieldset>
            <div class="dialog-actions"><button type="submit" disabled="@(Session.Busy || string.IsNullOrWhiteSpace(NewTemplateName))">@L("Save", "保存")</button><button type="button" @onclick="CloseSettings" disabled="@Session.Busy">@L("Cancel", "取消")</button></div>
        </form>
    </section></div>
}
</div>
</CascadingValue>
@code {
    [Parameter] public string InitialLanguage { get; set; } = "en";
    protected override string CurrentLanguage => Language ?? InitialLanguage;
    [Parameter, EditorRequired] public DataAnalysisSession Session { get; set; } = default!;
    [Parameter, EditorRequired] public IDesktopServices Desktop { get; set; } = default!;
    private List<string> groups = [];
    private List<AnalysisCalculation> calculations = [];
    private List<AnalysisFormula> formulas = [];
    private string defaultSort = "";
    private bool defaultSortDescending;
    private string settingsDialog = "";
    private long selectedTemplateId;
    private bool isNewTemplateDraft;
    private int filterEditorVersion;
    private AnalysisFilterConfig? filters, templateFilters;
    private AnalysisNumberFormat? countFormat;
    public void ApplyFilters(AnalysisFilterConfig value)
    {
        conditions = [];
        filters = AnalysisFilters.ToFixedConditions(value); filterEditorVersion++; CloseSettings();
    }
    private async Task SearchAdvancedAsync(AnalysisFilterConfig value) { ApplyFilters(value); await AnalyzeAsync(); }
    private IReadOnlyList<SearchField> SearchFields => Session.Source.TextColumns.Select(n => new SearchField(n, n)).ToArray();
    private async Task AnalyzeConditionsAsync(IReadOnlyList<SearchCondition> value) { conditions = value; await AnalyzeAsync(); }
    public async Task ClearAllFiltersAsync() { if (Session.Busy) return; filters = null; conditions = [];  filterEditorVersion++; await AnalyzeAsync(); }
    private AnalysisRequest SaveRequest => Request;
    private IReadOnlyList<SearchCondition> templateConditions = [];
    private string FilterSummary(AnalysisFilterConfig? config) => AnalysisFilters.Summary(config,
        CurrentLanguage == "zh-CN" ? key => key switch
        {
            "AND" => "且",
            "All text fields" => "所有文本字段",
            _ => FilterOperation(key)
        } : null);
    private string DefaultFilterSummary => string.Join(L(" AND ", " 且 "), new[]
    {
        FilterSummary(templateFilters),
        string.Join(L(" AND ", " 且 "), templateConditions.Select(c =>
            (string.IsNullOrEmpty(c.Column) ? L("All text fields", "所有文本字段") : c.Column)
            + L(" contains ", " 包含 ") + "\"" + c.Text + "\""))
    }.Where(s => !string.IsNullOrEmpty(s)));
    private void SetTemplateConditions(AnalysisRequest request) { templateConditions = request.Conditions?.Where(c => !string.IsNullOrEmpty(c.Text)).ToArray() ?? []; templateFilters = AnalysisFilters.Snapshot(request.Filters); }
    private async Task TemplateSelectionChangedAsync()
    {
        if (selectedTemplateId > 0) isNewTemplateDraft = false;
        templateConditions = [];
        templateFilters = null;
        if (selectedTemplateId > 0 && await Session.LoadTemplateAsync(selectedTemplateId, false) is { } request) SetTemplateConditions(request);
    }
    public string NewTemplateName { get; set; } = "";
    private void CommitSavedTemplate(AnalysisRequest saved)
    {
        SetTemplateConditions(saved);

    }
    public async Task NewTemplateAsync()
    {
        if (Session.Busy || settingsDialog.Length > 0) return;
        if (selectedTemplateId > 0)
        {
            var request = await Session.LoadTemplateAsync(selectedTemplateId, false);
            if (request == null) return;
            groups = request.Groups.ToList(); calculations = request.Calculations.ToList(); formulas = (request.Formulas ?? []).ToList(); includeCount = request.IncludeCount;
            defaultSort = request.SortBy ?? ""; defaultSortDescending = request.SortDescending;
            conditions = request.Conditions?.ToArray() ?? [];
            filters = AnalysisFilters.Snapshot(request.Filters); countFormat = request.CountFormat;
        }
        selectedTemplateId = 0; templateConditions = []; templateFilters = null; NewTemplateName = ""; isNewTemplateDraft = true; clipboardMessage = "";
        filterEditorVersion++;
        Session.Reset(); displayedResult = null; order = []; page = 0; sortColumn = -1; selected = null;
    }
    public async Task SaveCurrentTemplateAsync()
    {
        if (Session.Busy || settingsDialog.Length > 0) return;
        clipboardMessage = "";
        var template = Session.Templates.FirstOrDefault(t => t.Id == selectedTemplateId);
        if (template == null) { NewTemplateName = ""; settingsDialog = "save-template"; return; }
        var saved = SaveRequest;
        if (await Session.SaveTemplateAsync(template.Name, saved) is { } id) { selectedTemplateId = id; CommitSavedTemplate(saved); }
    }
    public async Task SaveNewTemplateAsync()
    {
        if (Session.Busy || settingsDialog != "save-template" || string.IsNullOrWhiteSpace(NewTemplateName)) return;
        var saved = SaveRequest;
        if (await Session.SaveTemplateAsync(NewTemplateName, saved, isNewTemplateDraft) is { } id) { selectedTemplateId = id; isNewTemplateDraft = false; CommitSavedTemplate(saved); CloseSettings(); }
    }
    public void OpenTemplateManager() { if (!Session.Busy) { clipboardMessage = ""; settingsDialog = "templates"; } }
    private async Task TemplateSelected(long id) { selectedTemplateId = id; await TemplateSelectionChangedAsync(); }
    public async Task ApplyTemplateAsync(long templateId)
    {
        clipboardMessage = "";
        if (Session.Busy || templateId == 0) return;
        var request = await Session.LoadTemplateAsync(templateId);
        if (request == null) return;
        if (request.Conditions is { Count: > 0 }) conditions = request.Conditions.ToArray();
        if (request.Filters != null) { filters = AnalysisFilters.Snapshot(request.Filters); conditions = request.Conditions?.ToArray() ?? []; }
        else if (request.Conditions is { Count: > 0 }) { filters = null; }
        countFormat = request.CountFormat;
        filterEditorVersion++;
        selectedTemplateId = templateId;
        isNewTemplateDraft = false;
        SetTemplateConditions(request);
        groups = request.Groups.ToList(); calculations = request.Calculations.ToList(); formulas = (request.Formulas ?? []).ToList(); includeCount = request.IncludeCount;
        defaultSort = request.SortBy ?? ""; defaultSortDescending = request.SortDescending;
        displayedResult = null; order = []; page = 0; sortColumn = -1; selected = null;
        await AnalyzeAsync();
    }
    private string CalculationSummary => string.Join(", ", calculations.Select(c => c.DisplayName).Concat(includeCount ? new[] { L("Record count", "记录数") } : []).Concat(formulas.Select(f => f.Name)));
    public void OpenGroupSettings() { if (!Session.Busy) settingsDialog = "groups"; }
    public void OpenCalculationSettings() { if (!Session.Busy) settingsDialog = "calculations"; }
    public void OpenFilterSettings() { if (!Session.Busy) settingsDialog = "filters"; }
    public void CloseSettings() => settingsDialog = "";
    public void ApplyGroups(IReadOnlyList<string> value) { groups = value.ToList(); CloseSettings(); }
    public void ApplyCalculations(AnalysisCalculationSettings value)
    {
        calculations = value.Calculations.ToList(); formulas = value.Formulas.ToList(); includeCount = value.IncludeCount; CloseSettings();
        defaultSort = value.SortBy; defaultSortDescending = value.SortDescending;
        countFormat = value.CountFormat;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("tableEditorModal.sync"); }
        catch (JSDisconnectedException) { }
    }
    private bool includeCount = true, descending;
    private IReadOnlyList<SearchCondition> conditions = [];
    private string clipboardMessage = "";
    public void SetConditions(IReadOnlyList<SearchCondition> value) { conditions = value; filterEditorVersion++; }
    private int[] order = [];
    private int page, sortColumn = -1;
    private int? selected;
    private QueryResultSnapshot? displayedResult;
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(displayedResult, Session.Result)) return;
        displayedResult = Session.Result;
        order = Enumerable.Range(0, Session.Result?.RowCount ?? 0).ToArray(); page = 0; sortColumn = -1; selected = null;
    }
    private int PageCount => Math.Max(1, (order.Length + 99) / 100);
    private AnalysisRequest Request => new(groups.ToArray(), calculations.ToArray(), includeCount, Formulas: formulas.ToArray(), Conditions: conditions.ToArray(), SortBy: defaultSort, SortDescending: defaultSortDescending, Filters: filters, CountFormat: countFormat);
    public async Task AnalyzeAsync()
    {
        if (Session.Busy) return;
        clipboardMessage = "";
        await Session.AnalyzeAsync(Request);
        displayedResult = Session.Result;
        order = Enumerable.Range(0, Session.Result?.RowCount ?? 0).ToArray(); page = 0; sortColumn = -1; selected = null;
    }
    private bool exportFormatted = true;
    private async Task ExportAsync()
    {
        clipboardMessage = "";
        string name = Session.Templates.FirstOrDefault(t => t.Id == selectedTemplateId)?.Name ?? "";
        await Session.ExportAsync(Desktop, name, exportFormatted);
    }
    private void Reset()
    {
        if (Session.Busy) return;
        groups.Clear(); calculations.Clear(); formulas.Clear(); includeCount = true; conditions = []; clipboardMessage = "";
        defaultSort = ""; defaultSortDescending = false;
        selectedTemplateId = 0;
        isNewTemplateDraft = false;
        templateConditions = [];
        templateFilters = null; filters = null; countFormat = null;
        filterEditorVersion++;
        Session.Reset(); displayedResult = null; order = []; page = 0; sortColumn = -1; selected = null;
    }
    private bool IsSelected(int index) => selected == index;
    private void Select(int index) => selected = index;
    private string SortState(int column) => sortColumn == column ? (descending ? "descending" : "ascending") : "none";
    private void Sort(int column)
    {
        if (Session.Result == null) return;
        descending = sortColumn == column && !descending; sortColumn = column;
        order = Session.Result.Sort(column, descending); page = 0; selected = null;
    }
    private async Task CopyAsync(bool all)
    {
        if (Session.Result == null || (!all && selected == null)) return;
        try { await Desktop.CopyTextAsync(Session.Result.CopyText(all ? order : new[] { selected!.Value })); clipboardMessage = L("Copied analysis rows.", "已复制分析结果。"); }
        catch (Exception ex) { clipboardMessage = ex.ToString(); }
    }
}
