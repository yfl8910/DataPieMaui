@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using DataPieMaui.Services
@implements IDisposable

<main>
    <header><div><h1>Query results</h1><p>@snapshot?.Connection</p><p>@snapshot?.Source</p></div><span class="badge">Read-only preview</span></header>
    @if (snapshot is null)
    {
        <div class="empty">Run a query in the main window to view results.</div>
    }
    else
    {
        <div class="toolbar">
            <strong>@snapshot.RowCount.ToString("N0") rows · @snapshot.ColumnCount columns</strong>
            <button @onclick="() => CopyAsync(false)" disabled="@(selected is null)">Copy selected row</button>
            <button @onclick="() => CopyAsync(true)" disabled="@(order.Length == 0)">@(filterColumn >= 0 ? "Copy matching rows" : "Copy all preview rows")</button>
        </div>
        <form class="search-toolbar" @onsubmit="ApplySearch" @onsubmit:preventDefault>
            <label>Column <select @bind="searchColumn">
                <option value="-1">Select a column</option>
                @for (int c = 0; c < snapshot.ColumnCount; c++)
                {
                    if (snapshot.GetColumnType(c) != typeof(byte[])) { <option value="@c">@snapshot.GetColumnName(c)</option> }
                }
            </select></label>
            <label>Search <input type="search" @bind="searchText" @bind:event="oninput" placeholder="Contains text in loaded preview" /></label>
            <button type="submit" disabled="@(searchColumn < 0)">Search</button>
            <button type="button" @onclick="ClearSearch">Clear</button>
            @if (filterColumn >= 0) { <span>Filtered by @snapshot.GetColumnName(filterColumn): @filterText</span> }
        </form>
        @if (snapshot.Truncated)
        {
            <div class="notice">Showing the first 1,000 rows. Use export in the main window to retrieve the full result.</div>
        }
        <div class="table-scroll" tabindex="0" aria-label="Query result table">
            <table>
                <thead><tr>
                    <th class="row-number">#</th>
                    @for (int c = 0; c < snapshot.ColumnCount; c++)
                    {
                        int column = c;
                        <th aria-sort="@(sortColumn == c ? (descending ? "descending" : "ascending") : "none")">
                            <button @onclick="() => Sort(column)" disabled="@(snapshot.GetColumnType(c) == typeof(byte[]))">@snapshot.GetColumnName(c) @(sortColumn == c ? (descending ? "▼" : "▲") : "")</button>
                        </th>
                    }
                </tr></thead>
                <tbody>
                    @foreach (int index in order.Skip(page * PageSize).Take(PageSize))
                    {
                        <tr @key="index" class="@(selected == index ? "selected" : "")" tabindex="0" aria-selected="@(selected == index)" @onclick="() => Select(index)" @onkeydown="e => SelectWithKey(e, index)">
                            <td class="row-number">@(index + 1)</td>
                            @for (int c = 0; c < snapshot.ColumnCount; c++)
                            {
                                var text = snapshot.FormatCell(index, c);
                                <td class="@(snapshot.IsNull(index, c) ? "null" : "")" title="@text">@text</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            @if (order.Length == 0) { <div class="empty">@(filterColumn >= 0 ? "No matching records in the loaded preview." : "The query returned no rows.")</div> }
        </div>
        <footer>
            <span role="status">@message</span>
            <div class="pagination"><button @onclick="Previous" disabled="@(page == 0)">Previous</button><span>Page @(page + 1)/@PageCount · @order.Length.ToString("N0") rows</span><button @onclick="Next" disabled="@(page + 1 >= PageCount)">Next</button></div>
        </footer>
    }
</main>

@code {
    [Parameter, EditorRequired] public QueryResultSession Session { get; set; } = default!;
    [Parameter, EditorRequired] public IDesktopServices Desktop { get; set; } = default!;
    private QueryResultSnapshot? snapshot;
    private int[] order = [];
    private const int PageSize = 100;
    private int page, sortColumn = -1;
    private int searchColumn = -1, filterColumn = -1;
    private string searchText = "", filterText = "";
    private int? selected;
    private bool descending, disposed;
    private string message = "Click a column to sort. Select a row to copy it.";
    private int PageCount => Math.Max(1, (order.Length + PageSize - 1) / PageSize);

    protected override void OnInitialized() { Session.Changed += Refresh; Load(); }
    private void Refresh() => _ = InvokeAsync(() => { if (!disposed) { Load(); StateHasChanged(); } });
    private void Load()
    {
        snapshot = Session.Current;
        order = Enumerable.Range(0, snapshot?.RowCount ?? 0).ToArray();
        page = 0; sortColumn = -1; selected = null; descending = false;
        searchColumn = filterColumn = -1; searchText = filterText = "";
        message = "Click a column to sort. Select a row to copy it.";
    }
    public void ApplySearch() => Search(searchColumn, searchText);
    public void Search(int column, string text)
    {
        if (snapshot == null || column < 0 || column >= snapshot.ColumnCount || snapshot.GetColumnType(column) == typeof(byte[])) return;
        filterColumn = string.IsNullOrEmpty(text) ? -1 : column;
        filterText = text;
        RebuildOrder();
        message = "Search covers loaded preview rows only. Matches displayed text, ignoring case.";
    }
    public void ClearSearch()
    {
        searchColumn = filterColumn = -1; searchText = filterText = "";
        RebuildOrder(); message = "Search cleared.";
    }
    private void RebuildOrder()
    {
        if (snapshot == null) return;
        var indices = sortColumn >= 0 ? snapshot.Sort(sortColumn, descending) : Enumerable.Range(0, snapshot.RowCount).ToArray();
        order = indices.Where(i => filterColumn < 0 || (!snapshot.IsNull(i, filterColumn)
            && snapshot.FormatCell(i, filterColumn).Contains(filterText, StringComparison.OrdinalIgnoreCase))).ToArray();
        page = 0; selected = null;
    }
    public void Sort(int column)
    {
        descending = sortColumn == column && !descending;
        sortColumn = column;
        RebuildOrder();
    }
    private void Select(int index) => selected = index;
    private void SelectWithKey(KeyboardEventArgs e, int index) { if (e.Key is "Enter" or " ") Select(index); }
    private void Previous() { if (page > 0) page--; }
    private void Next() { if (page + 1 < PageCount) page++; }
    public async Task CopyAsync(bool all)
    {
        if (snapshot is null || (!all && selected is null)) return;
        try
        {
            var text = snapshot.CopyText(all ? order : new[] { selected!.Value });
            await Desktop.CopyTextAsync(text);
            message = all ? $"Copied {order.Length:N0} preview rows." : "Copied selected row.";
        }
        catch (Exception ex) { message = "Copy failed: " + ex.Message; }
    }
    public void Dispose() { disposed = true; Session.Changed -= Refresh; }
}
