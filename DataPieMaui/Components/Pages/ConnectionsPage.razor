@using DBUtil
@inherits WorkspacePageBase
<section class="card">
    <div class="tabs" aria-label="@L("Connection type", "连接类型")">
        @foreach (var tab in new[] { ("SqlServer", "SQL Server"), ("Sqlite", "SQLite"), ("Saved", L("Saved connections", "已保存的连接")) })
        {
            <button class="@(Model.Form.ConnectionTab == tab.Item1 ? "active" : "")" @onclick="() => Model.Form.ConnectionTab = tab.Item1">@tab.Item2</button>
        }
    </div>
    @if (Model.Form.ConnectionTab == "SqlServer")
    {
        <h2>@L("Connect to SQL Server", "连接 SQL Server")</h2>
        <div class="form-grid">
            <label>@L("Server", "服务器")<input @bind="Model.Form.Server" @bind:event="oninput" placeholder="@L("(local) or server\\instance", "本机 (local) 或 服务器\\实例")" /></label>
            <label>@L("Authentication", "身份验证")<select @bind="Model.Form.Authentication"><option value="Windows">@L("Windows", "Windows 身份验证")</option><option value="SQL Server">@L("SQL Server", "SQL Server 身份验证")</option></select></label>
            <label>@L("Username", "用户名")<input @bind="Model.Form.UserName" @bind:event="oninput" disabled="@(Model.Form.Authentication == "Windows")" autocomplete="off" /></label>
            <label>@L("Password", "密码")<input type="password" @bind="Model.Form.Password" @bind:event="oninput" disabled="@(Model.Form.Authentication == "Windows")" autocomplete="off" /></label>
        </div>
        <div class="actions align-end"><button @onclick="LoadDatabasesAsync">@L("Load databases", "加载数据库列表")</button><label class="grow">@L("Database", "数据库")<select @bind="Model.Form.DatabaseName"><option value="">@L("Select a database", "选择数据库")</option>@foreach (var name in Model.Databases) { <option value="@name">@name</option> }</select></label><button class="primary" @onclick="ConnectServerAsync">@L("Connect and save", "连接并保存")</button></div>
    }
    else if (Model.Form.ConnectionTab == "Sqlite")
    {
        <h2>@L("Connect to SQLite", "连接 SQLite")</h2><p class="muted">@L("Connect and save opens an existing database and saves its connection. Creating a blank database connects without saving the connection.", "“连接并保存”会打开现有数据库并保存连接。创建空数据库时会直接连接。")</p>
        <div class="actions align-end"><label class="grow">@L("Database file", "数据库文件")<input @bind="Model.Form.SqlitePath" @bind:event="oninput" placeholder="@L("Path to a SQLite database", "SQLite 数据库文件路径")" /></label><button @onclick="BrowseSqliteAsync">@L("Browse file", "浏览文件")</button></div>
        <label>@L("Password (optional)", "密码（可选）")<input type="password" @bind="Model.Form.SqlitePassword" @bind:event="oninput" autocomplete="off" /></label>
        <p class="muted">@L("Supports SQLCipher 4 databases. Leave blank for unencrypted files. Passwords are used for this session only.", "支持 SQLCipher 4 数据库。未加密的文件可留空。密码仅用于当前会话。")</p>
        <div class="actions"><button class="primary" @onclick="ConnectSqliteAsync">@L("Connect and save", "连接并保存")</button><button @onclick="CreateSqliteAsync" disabled="@(Model.Form.SqlitePassword.Length > 0)">@L("Create blank database and connect", "创建空数据库并连接")</button></div>
    }
    else
    {
        <h2>@L("Saved connections", "已保存的连接")</h2>
        <div class="actions align-end"><label class="grow">@L("Connection", "连接")<select value="@Model.Form.SelectedConnectionId" @onchange="Select"><option value="0">@L("Select a connection", "选择连接")</option>@foreach (var item in Model.Connections) { <option value="@item.Id">@item.Dbname · @item.Dbtype</option> }</select></label><button class="primary" @onclick="ConnectSavedAsync">@L("Connect", "连接")</button><button class="danger" @onclick="DeleteConnectionAsync">@L("Delete", "删除")</button></div>
        <hr /><h2>@L("Connection details", "连接详情")</h2>
        @if (Model.Connections.FirstOrDefault(c => c.Id == Model.Form.SelectedConnectionId)?.Dbtype == "SQLITE")
        {
            <label>@L("SQLite password (optional, not saved)", "SQLite 密码（可选，仅用于当前会话）")<input type="password" @bind="Model.Form.SqlitePassword" @bind:event="oninput" autocomplete="off" /></label>
        }
        <label>@L("Connection string", "连接字符串")<input type="text" value="@Model.Form.ConnectionString" readonly autocomplete="off" /></label>
    }
</section>

@code {
    private ConnectionStore Store => Context.ConnectionStore;
    protected override Task OnInitializedAsync() => InitializeAsync();

    public Task InitializeAsync() => Context.ConnectionsInitialized ? Task.CompletedTask : RunAsync("Load connections", async watch =>
    {
        if (Context.ConnectionsInitialized) { watch.Start(); return; }
        watch.Start();
        await ReloadConnectionsAsync();
        Context.ConnectionsInitialized = true;
    });

    private async Task ReloadConnectionsAsync() => Connections = await Task.Run(Store.Load);
    public void SelectConnection(int id)
    {
        if (IsOperationRunning) return;
        Form.SelectedConnectionId = id;
        var selected = Connections.FirstOrDefault(x => x.Id == id);
        Form.ConnectionString = selected == null ? "" : DataPieMaui.Services.Shared.ConnectionCredentials.Display(Info(selected).ConnectionString);
        Form.SqlitePassword = "";
        Notify();
    }
    private Dbinfo SelectedConnection() => Connections.FirstOrDefault(x => x.Id == Form.SelectedConnectionId) ?? throw new InvalidOperationException(L("Select a connection.", "请选择连接。"));
    private static DatabaseConnectionInfo Info(Dbinfo record) => new(record.Dbtype, record.ConnectionStrings, record.Dbname);

    private async Task ConnectAsync(Dbinfo record, bool save)
    {
        bool connecting = true;
        var progress = new Progress<string>(value =>
        {
            if (connecting && State.Busy)
                State.SetStatus(value, value switch
                {
                    "Connecting to database…" => "正在连接数据库…",
                    "Reading database object list…" => "正在读取数据库对象列表…",
                    _ => null
                });
        });
        try { await Database.ConnectAsync(Info(record), progress); }
        catch (Exception) when (record.Dbtype == "SQLITE")
        {
            throw new InvalidOperationException(L("Unable to open the SQLite database. Check the file, permissions and password. Encrypted files must use SQLCipher 4 with default encryption settings.", "无法打开 SQLite 数据库。请检查文件、权限和密码。加密文件须使用 SQLCipher 4 的默认加密设置。"));
        }
        finally { connecting = false; }
        var setupWatch = System.Diagnostics.Stopwatch.StartNew();
        State.DatabaseType = Database.Connection!.DatabaseType;
        Tables = Database.Schema!.Tables.Select(t => t.Name).ToArray();
        Form.ImportTable = Database.Schema.Tables.FirstOrDefault() is { } first ? DataPieMaui.Services.Shared.TableSelection.Key(first, Type) : "";
        Form.QueryTable = Form.ImportTable;
        Form.Sql = Form.ImportPath = Form.ImportFolder = "";
        Form.CreateTableSql = "";
        Form.DropTable = "";
        Results.Set(null);
        QuerySummary = "Run a preview to open the result table in a separate window.";
        Form.ExportTab = "Table";
        Form.ProcedureTab = "WithoutParameters";
        Exports.Clear();
        Exports.AddRange(Tables.Select(n => new SelectableObject(n, "Table")));
        Exports.AddRange(Database.Schema.DefinitionObjects.Where(o => o.Kind == "View").Select(o => new SelectableObject(o.Name, o.Kind) { DefinitionObject = o }));
        Procedures.Clear();
        Procedures.AddRange(Database.Schema.DefinitionObjects.Where(o => o.Kind == "Procedure").Select(o => new SelectableObject(o.Name, o.Kind) { DefinitionObject = o }));
        State.Connection = record.Dbname + " · " + record.Dbtype;
        if (save) { await Task.Run(() => Store.Save(record, true)); await ReloadConnectionsAsync(); }
        if (record.Dbtype == "SQLITE") Form.SqlitePassword = "";
        Section = "Query";
        setupWatch.Stop();
        State.SetStatus("Connected · " + Database.ConnectionTiming + $" · Workspace {setupWatch.Elapsed.TotalSeconds:F2}s",
            "已连接 · " + Database.ChineseConnectionTiming + $" · 工作台初始化 {setupWatch.Elapsed.TotalSeconds:F2} 秒");
    }

    public Task ConnectSavedAsync() => RunAsync("Connect to database", async watch =>
    {
        var original = SelectedConnection();
        var record = new Dbinfo { Id = original.Id, Dbname = original.Dbname, Dbtype = original.Dbtype,
            ConnectionStrings = Info(original).ConnectionString };
        if (record.Dbtype == "SQLITE") record.ConnectionStrings = DataPieMaui.Services.Shared.ConnectionCredentials.WithSqlitePassword(record.ConnectionStrings, Form.SqlitePassword);
        watch.Start();
        await ConnectAsync(record, false);
        if (record.ConnectionStrings != original.ConnectionStrings || record.Dbtype == "SQLITE")
        {
            await Task.Run(() => Store.Save(record));
            await ReloadConnectionsAsync();
        }
    });
    public Task DeleteConnectionAsync() => RunAsync("Delete connection", async watch =>
    {
        var item = SelectedConnection();
        if (!await Dialogs.ConfirmAsync("Delete connection", "Delete only the saved connection configuration: " + item.Dbname, "Delete",
            "删除连接", $"将删除已保存的连接配置「{item.Dbname}」。", "删除")) return;
        watch.Start();
        await Task.Run(() => Store.Delete(item.Id));
        Form.SelectedConnectionId = 0;
        Form.ConnectionString = "";
        await ReloadConnectionsAsync();
    });
    private DBConfig SqlConfig(string name) => new()
    {
        ProviderName = "SQLSERVER", ServerName = Required(Form.Server, L("Enter a server address.", "请输入服务器地址。")).Trim(), DataBase = name,
        ValidataType = Form.Authentication, UserName = Form.UserName, UserPwd = Form.Password
    };
    public Task LoadDatabasesAsync() => RunAsync("Load databases", async watch =>
    {
        var connection = SqlConfig("master").GetSQLmasterConstring(); watch.Start();
        Databases = await Task.Run(() => { using var access = DbAccessFactory.Create(connection, "SQLSERVER"); return access.GetDataBaseInfo().ToArray(); });
        Form.DatabaseName = Databases.FirstOrDefault() ?? "";
    });
    public Task ConnectServerAsync() => RunAsync("Connect to SQL Server", async watch =>
    {
        var name = Required(Form.DatabaseName, L("Select a database.", "请选择数据库。")); watch.Start();
        await ConnectAsync(new Dbinfo { Dbname = name, Dbtype = "SQLSERVER", ConnectionStrings = SqlConfig(name).GetConstring() }, true);
    });
    public Task BrowseSqliteAsync() => RunAsync("Select SQLite file", async watch =>
    {
        var path = await Desktop.OpenAsync(".db", ".sqlite", ".sqlite3");
        if (path == null) return;
        watch.Start(); Form.SqlitePath = path; Form.SqlitePassword = "";
    });
    public Task ConnectSqliteAsync() => RunAsync("Connect to SQLite", async watch =>
    {
        if (!File.Exists(Form.SqlitePath)) throw new FileNotFoundException("Select an existing SQLite database.");
        var path = Path.GetFullPath(Form.SqlitePath); watch.Start();
        await ConnectAsync(new Dbinfo { Dbname = Path.GetFileNameWithoutExtension(path), Dbtype = "SQLITE", ConnectionStrings = new DBConfig { ProviderName = "SQLITE", DataBase = path, UserPwd = Form.SqlitePassword }.GetConstring() }, true);
    });

    public Task CreateSqliteAsync() => RunAsync("Create SQLite database", async watch =>
    {
        if (Form.SqlitePassword.Length > 0) throw new InvalidOperationException(L("Clear the password to create a blank, unencrypted database. Creating encrypted databases is not supported.", "请清除密码以创建未加密的空数据库。"));
        var selectedPath = await Desktop.SelectNewFilePathAsync("NewDatabase", ".db");
        if (selectedPath == null) return;
        var path = Path.GetFullPath(selectedPath);
        if (File.Exists(path))
        {
            await ShowExistingDatabaseAsync(path);
            return;
        }
        watch.Start();
        var created = await Task.Run(() =>
        {
            // Reserve a new file atomically; never truncate an existing database.
            try
            {
                using var file = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None);
            }
            catch (IOException) when (File.Exists(path)) { return false; }
            var builder = new System.Data.SQLite.SQLiteConnectionStringBuilder { DataSource = path, Pooling = false };
            using var connection = new System.Data.SQLite.SQLiteConnection(builder.ToString());
            connection.Open();
            // Materialize a valid SQLite header and empty schema without adding a user table.
            using var command = new System.Data.SQLite.SQLiteCommand("VACUUM", connection);
            command.ExecuteNonQuery();
            return true;
        });
        if (!created)
        {
            watch.Stop();
            await ShowExistingDatabaseAsync(path);
            return;
        }
        Form.SqlitePath = path;
        await ConnectAsync(new Dbinfo { Dbname = Path.GetFileNameWithoutExtension(path), Dbtype = "SQLITE", ConnectionStrings = new DBConfig { ProviderName = "SQLITE", DataBase = path }.GetConstring() }, false);
        watch.Stop();
        State.SetStatus($"Blank SQLite database created and connected in {watch.Elapsed.TotalSeconds:F1} s · File: {path}",
            $"已创建并连接空 SQLite 数据库，耗时 {watch.Elapsed.TotalSeconds:F1} 秒。文件：{path}");
    });

    private async Task ShowExistingDatabaseAsync(string path)
    {
        State.SetStatus("Database creation canceled: the selected file already exists.", "所选文件已存在，已取消创建数据库。");
        await Dialogs.AlertAsync("File already exists", $"{path} already exists. Choose a new filename to create a blank database. To open this database, use Browse file and Connect and save.",
            "文件已存在", $"文件 {path} 已存在。请使用新文件名创建空数据库。要打开此数据库，请使用“浏览文件”和“连接并保存”。");
    }

    private void Select(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id)) SelectConnection(id);
    }
}
