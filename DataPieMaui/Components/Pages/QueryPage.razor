@using DataPieCore
@using DataPieMaui.Services.Shared
@inherits WorkspacePageBase
<section class="card">
    <div class="actions align-end"><label class="grow">@L("Table", "表")<select @bind="Model.Form.QueryTable"><option value="">@L("Select a table", "选择表")</option>@foreach (var table in Database.Schema!.Tables) { <option value="@TableSelection.Key(table, Type)">@TableSelection.Label(table, Type)</option> }</select></label>
        @foreach (var kind in new[] { "SELECT", "UPDATE", "DELETE" }) { <button @onclick="() => GenerateAsync(kind)">@kind</button> }
        <button @onclick="EditQueryTableAsync" disabled="@(string.IsNullOrEmpty(Form.QueryTable))">@L("Query&Edit", "查询并编辑")</button>
    </div>
    <label>@L("SQL editor", "SQL 编辑器")<textarea class="sql-editor" @bind="Model.Form.Sql" @bind:event="oninput" spellcheck="false" placeholder="@L("Enter SQL. Preview shows up to 1,000 rows.", "输入 SQL。预览最多显示 1,000 行。")"></textarea></label>
    <div class="actions"><button class="primary" @onclick="PreviewAsync">@L("Preview query", "预览查询")</button><button @onclick="ExecuteSqlAsync">@L("Run SQL", "执行 SQL")</button><span class="action-divider"></span><button @onclick="() => ExportQueryAsync(false, false)">@L("Query to Excel", "查询结果导出为 Excel")</button><button @onclick="() => ExportQueryAsync(true, false)">@L("Query to CSV", "查询结果导出为 CSV")</button></div>
    @if (Results.Current is { HasArchive: true } captured)
    {
        <div class="actions">
            <span>@L("Last preview", "最近一次预览") · @captured.Source · @captured.TotalRows.ToString("N0") @L("rows", "行")</span>
            <button @onclick="() => ExportCapturedAsync(false)">@L("Export preview to Excel", "预览结果导出为 Excel")</button>
            <button @onclick="() => ExportCapturedAsync(true)">@L("Export preview to CSV", "预览结果导出为 CSV")</button>
        </div>
    }
</section>

@code {
    private DBUtil.TableStruct SelectedQueryTable() => TableSelection.Resolve(Database.Schema!.Tables, Required(Form.QueryTable, "Select a table."), Type);
    public Task EditQueryTableAsync() => RunAsync("Open table editor", watch => OpenTableEditorAsync(SelectedQueryTable(), watch));
    private async Task Generate(string kind)
    {
        var table = SelectedQueryTable();
        await Database.EnsureColumnsAsync(table);
        Form.Sql = kind switch
        {
            "UPDATE" => SqlWriter.WriteUpdate(table, Type),
            "DELETE" => SqlWriter.WriteDelete(table, Type),
            _ => SqlWriter.WriteSelect(table, Type, 1000)
        };
    }

    public Task GenerateAsync(string kind) => RunAsync("Generate " + kind, async watch =>
    {
        watch.Start();
        await Generate(kind);
    });

    public Task PreviewAsync() => RunAsync("Query", async watch =>
    {
        if (string.IsNullOrWhiteSpace(Form.Sql)) await Generate("SELECT");
        await Context.Preview.LoadAsync(Form.Sql, "SQL query", watch);
    });
    public Task OpenResultsAsync() => RunAsync("Open results", async watch =>
    {
        watch.Start();
        if (Results.Current != null) await Desktop.ShowTablePreviewAsync(Results);
    });

    public Task ExecuteSqlAsync() => RunAsync("Run SQL", async watch =>
    {
        var sql = Required(Form.Sql, "Enter SQL.");
        if (!await Dialogs.ConfirmAsync("Run SQL", "Run the SQL in the editor against the current database?", "Run")) return;
        watch.Start();
        int count = await Task.Run(() =>
        {
            using var access = Database.OpenAccess();
            return access.ExecuteSql(sql);
        });
        watch.Stop();
        State.Status = $"SQL completed in {watch.Elapsed.TotalSeconds:F1} s: {count:N0} rows affected";
    });
    public Task ExportQueryAsync(bool csv, bool wholeTable) => wholeTable && !csv ? Context.TableActions.ExportExcelAsync(SelectedQueryTable()) : RunAsync("Export data", async watch =>
    {
        var table = wholeTable ? SelectedQueryTable() : null;
        string name = table?.Name ?? "Query";
        string sql = table != null ? TableSelection.SelectAll(table, Type) : Required(Form.Sql, "Enter SQL.");
        var path = await Desktop.SaveAsync(name, csv ? ".csv" : ".xlsx");
        if (path == null) return;
        watch.Start();
        await Task.Run(() =>
        {
            using var access = Database.OpenAccess();
            using var reader = access.GetDataReader(sql);
            if (csv) CsvExporter.SaveCsv(reader, path);
            else ExcelIO.SaveMiniExcel(path, reader, name);
        });
        watch.Stop();
        State.Status = $"Export data completed in {watch.Elapsed.TotalSeconds:F1} s · File: {Path.GetFullPath(path)}";
    });

    public Task ExportCapturedAsync(bool csv) => RunAsync("Export preview", async watch =>
    {
        if (Results.Current is not { HasArchive: true } captured) return;
        var path = await Desktop.SaveAsync("Query preview", csv ? ".csv" : ".xlsx");
        if (path == null) return;
        watch.Start();
        await Task.Run(() => captured.Export(path, csv));
    });
}
