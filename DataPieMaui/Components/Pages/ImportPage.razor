<section class="card">
    <div class="actions align-end"><label class="grow">Target table<select @bind="W.Form.ImportTable"><option value="">Select a table</option>@foreach (var name in W.Tables) { <option value="@name">@name</option> }</select></label><button @onclick="W.PreviewImportTableAsync" disabled="@(string.IsNullOrEmpty(W.Form.ImportTable))">Query data</button><button @onclick="W.ExportTemplateAsync">Export blank template</button><button class="danger" @onclick="W.ClearTableAsync">Clear target table</button></div>
</section>
<section class="card"><h2>Import a file</h2><p class="muted">Excel, CSV, or a SQLite database containing a table with the same name.</p>
    <div class="actions align-end"><label class="grow">Source file<input @bind="W.Form.ImportPath" @bind:event="oninput" placeholder="Select a file to import" /></label><button @onclick="() => W.BrowseImportAsync(false)">Browse file</button><button class="primary" @onclick="W.ImportFileAsync">Import file</button></div>
</section>
<section class="card"><h2>Batch import</h2><p class="muted">Append each CSV and XLSX file in the folder to the target table.</p>
    <div class="actions align-end"><label class="grow">Source folder<input @bind="W.Form.ImportFolder" @bind:event="oninput" placeholder="Select an import folder" /></label><button @onclick="() => W.BrowseImportAsync(true)">Browse folder</button><button class="primary" @onclick="W.ImportDirectoryAsync">Import folder</button></div>
</section>
@code { [CascadingParameter] public WorkspaceController W { get; set; } = default!; }
