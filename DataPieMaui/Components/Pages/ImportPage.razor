@using DataPieCore
@using DataPieMaui.Services
@using DataPieMaui.Services.Shared
@inherits WorkspacePageBase


    <section class="card">
        <div class="actions align-end"><label class="grow">Target table<select @bind="Form.ImportTable"><option value="">Select a table</option>@foreach (var table in Database.Schema!.Tables) { <option value="@TableSelection.Key(table, Type)">@TableSelection.Label(table, Type)</option> }</select></label><button @onclick="EditImportTableAsync" disabled="@(string.IsNullOrEmpty(Form.ImportTable))">Query&amp;Edit</button><button @onclick="ExportTemplateAsync">Export template</button><button class="danger" @onclick="ClearTableAsync">Clear data</button></div>
    </section>
<section class="card">
    <TableImportView Options="Form.ImportOptions" Embedded="true" Disabled="IsOperationRunning" CanImport="@(!string.IsNullOrEmpty(Form.ImportTable))" OnBrowse="() => BrowseImportAsync(Form.ImportOptions.Batch)" OnComplete="ImportAsync" />
</section>

@code {
    public void ChangeTab(string tab)
    {
        if (IsOperationRunning || tab is not ("File" or "Batch")) return;
        Form.ImportTab = tab;
        Notify();
    }
    public Task EditImportTableAsync() => RunAsync("Open table editor", async watch =>
    {
        await OpenTableEditorAsync(SelectedImportTable(), watch);
    });

    public Task BrowseImportAsync(bool folder) => RunAsync(folder ? "Select folder" : "Select import file", async watch =>
    {
        var path = folder ? await Desktop.FolderAsync() : await Desktop.OpenAsync(".xlsx", ".xls", ".csv", ".db");
        if (path == null) return;
        watch.Start();
        if (folder) Form.ImportFolder = path;
        else Form.ImportPath = path;
    });
    private Task ImportAsync(bool accepted) => !accepted ? Task.CompletedTask : Form.ImportOptions.Batch ? ImportDirectoryAsync() : ImportFileAsync();
    public Task ImportFileAsync() => ImportFileAsync(Form.ImportOptions.ValidateLengths);
    public Task ImportFileWithLengthValidationAsync() => ImportFileAsync(true);
    private Task ImportFileAsync(bool validateFieldLengths) => RunAsync(validateFieldLengths ? "Validate lengths and import" : "Import file", async watch =>
    {
        var table = SelectedImportTable();
        string path = Form.ImportPath;
        if (!File.Exists(path)) throw new FileNotFoundException("Select an existing file.");
        watch.Start();
        await ImportIntoTableAsync(path, table, validateFieldLengths);
    });
    public Task ImportDirectoryAsync() => Context.TableActions.ImportDirectoryAsync(Form.ImportFolder, SelectedImportTable(), Form.ImportOptions.ValidateLengths);
    public Task ExportTemplateAsync() => RunAsync("Export template", async watch =>
    {
        var table = SelectedImportTable();
        string type = Type;
        var path = await Desktop.SaveAsync(table.Name + "_template", ".xlsx");
        if (path == null) return;
        watch.Start();
        await Task.Run(() =>
        {
            using var access = Database.OpenAccess();
            using var reader = access.GetDataReader(TableSelection.SelectAll(table, type) + " where 1=2");
            ExcelIO.SaveMiniExcel(path, reader, table.Name);
        });
        watch.Stop();
        State.Status = $"Export template completed in {watch.Elapsed.TotalSeconds:F1} s · File: {Path.GetFullPath(path)}";
    });
    public Task ClearTableAsync() => Context.TableActions.ClearAsync(SelectedImportTable());

    private DBUtil.TableStruct SelectedImportTable() => TableSelection.Resolve(Database.Schema!.Tables, Required(Form.ImportTable, "Select a table."), Type);

    private Task ImportIntoTableAsync(string path, DBUtil.TableStruct table, bool validateFieldLengths)
        => Context.TableActions.ImportIntoAsync(path, table, validateFieldLengths);
}
