@using DataPieCore
@inherits WorkspacePageBase
<section class="card">
    @if (State.DatabaseType == "SQLSERVER")
    {
        <div class="migration-mark">SQL Server <span>→</span> SQLite</div><h2>Create a SQLite database</h2>
        <p>Export tables, supported views, and procedure scripts from the current SQL Server database.</p>
        <div class="callout">Keep the generated <strong>StoredProcedures</strong> folder alongside the output database. Unsupported SQL is reported in the conversion results.</div>
        <p class="muted">Progress appears in the status bar. You can request cancellation while conversion is running. A canceled or failed conversion may leave an incomplete database.</p>
        <div class="actions"><button class="primary" disabled="@(Model.State.DatabaseType != "SQLSERVER")" @onclick="ConvertSqliteAsync">Choose destination and convert</button></div>
    }
    else if (State.DatabaseType == "SQLITE")
    {
        <div class="migration-mark">SQLite <span>→</span> SQL Server</div><h2>Generate SQL Server script</h2>
        <p>Export table columns, primary keys and supported foreign keys to a SQL file. No data is copied and no SQL Server connection is required.</p>
        <div class="callout">Only procedure records with Status = Success are eligible. Current SQLite .txt bodies are translated, including edits. Without an index, standalone scripts are supported. Unsupported syntax is skipped with warnings. Only a .sql structure script is saved; no data is copied and no SQL is executed.</div>
        <p class="muted">Tables are mapped to dbo. Review types, defaults, constraints and warnings before executing. Views, triggers and additional indexes require manual conversion. Existing destination tables are not dropped.</p>
        <div class="actions"><button class="primary" disabled="@(Model.State.DatabaseType != "SQLITE")" @onclick="ExportSqlServerAsync">Choose destination and generate script</button></div>
    }
    else
    {
        <p class="muted">Connect to SQL Server or SQLite to use database migration.</p>
    }
</section>
@if (State.DatabaseType == "SQLSERVER")
{
    <section class="card">
        <h2>SQL Server object script</h2>
        <p>Generate creation SQL for schemas, supported tables, primary keys, defaults, views and stored procedures from the current database.</p>
        <p class="muted">No data is copied and no generated SQL is executed. Other indexes and constraints, functions, triggers and user-defined types are excluded. Missing dependencies and skipped objects are reported; review the script before running it in an empty target database.</p>
        <div class="actions"><button @onclick="ExportSqlServerObjectsAsync">Generate SQL Server script</button></div>
    </section>
}
@code {
    public Task ExportSqlServerObjectsAsync() => RunAsync("Generate SQL Server object script", async watch =>
    {
        if (Type != "SQLSERVER") throw new InvalidOperationException("Connect to SQL Server first.");
        var connection = Database.Connection!;
        var path = await Desktop.SaveAsync(Database.Schema!.Name + "_schema", ".sql");
        if (path == null) return;
        watch.Start();
        var result = await Task.Run(() => SqlServerScriptExporter.Export(connection.ConnectionString, path));
        watch.Stop();
        State.Status = $"SQL Server object script generated{(result.Warnings.Count > 0 ? " with warnings" : "")} in {watch.Elapsed.TotalSeconds:F1} s · {result.Tables} tables · {result.Views} views · {result.Procedures} procedures · {result.Warnings.Count} warnings · File: {Path.GetFullPath(path)}";
        if (result.Warnings.Count > 0) await Dialogs.AlertAsync("SQL Server script export warnings", string.Join(Environment.NewLine, result.Warnings));
    });
    public Task ConvertSqliteAsync() => RunAsync("Convert to SQLite", async watch =>
    {
        if (Type != "SQLSERVER") throw new InvalidOperationException("Connect to SQL Server first.");
        var path = await Desktop.SaveAsync(Database.Schema!.Name, ".db");
        if (path == null) return;
        await Workspace.Conversion.ConvertAsync(path, watch);
    });
    public Task ExportSqlServerAsync() => RunAsync("Generate SQL Server script", async watch =>
    {
        if (Type != "SQLITE") throw new InvalidOperationException("Connect to SQLite first.");
        var path = await Desktop.SaveAsync(Database.Schema!.Name + "_SQLServer", ".sql");
        if (path == null) return;
        var connection = Database.Connection!.ConnectionString;
        watch.Start();
        var result = await Task.Run(() =>
        {
            var export = SQLiteSqlServerExporter.Generate(connection);
            File.WriteAllText(path, export.Sql, new System.Text.UTF8Encoding(false));
            return export;
        });
        watch.Stop();
        State.Status = $"SQL Server script generated in {watch.Elapsed.TotalSeconds:F1} s · {result.Tables} tables · {result.Procedures} procedures · {result.Warnings.Count} warnings · File: {path}";
        if(result.Warnings.Count > 0) await Dialogs.AlertAsync("Script export warnings", string.Join(Environment.NewLine,result.Warnings));
    });
}
