@using DBUtil
@inherits WorkspacePageBase

<section class="card schema-toolbar" aria-label="Schema search and filters">
    <input @bind="search" @bind:event="oninput" aria-label="Search objects" placeholder="Search objects by name or schema" />
    <select @bind="kind" aria-label="Object type"><option value="All">All types</option><option value="Table">Tables</option><option value="View">Views</option><option value="Procedure">Stored procedures</option></select>
    <button @onclick="RefreshAsync">Refresh schema</button>
</section>
<section class="card schema-browser">
    <div class="schema-object-list" aria-label="Database objects">
        @foreach (var category in new[] { (Kind: "Table", Label: "Tables"), (Kind: "View", Label: "Views"), (Kind: "Procedure", Label: "Stored procedures") })
        {
            var items = Objects.Where(o => o.Kind == category.Kind).OrderBy(o => o.Schema).ThenBy(o => o.Name).ToArray();
            @if (kind == "All" || kind == category.Kind)
            {
                <h3>@category.Label (@items.Length)</h3>
                @foreach (var item in items)
                {
                    <button class="@(selected == item ? "primary" : "")" @onclick="() => SelectAsync(item)">@item.DisplayName</button>
                }
                @if (items.Length == 0) { <p class="muted">No matching objects.</p> }
            }
        }
    </div>
    <div class="schema-details">
        @if (selected is null) { <p>Select a table, view or procedure to inspect it.</p> }
        else
        {
            <h2>@selected.DisplayName</h2><p>@selected.Kind</p>
            @if (selected.Kind == "Table")
            {
                <TableActionBar OnImport="ImportSelectedTableAsync" OnExport="ExportSelectedTableAsync" OnEdit="EditSelectedTableAsync" OnAnalyze="AnalyzeSelectedTableAsync" OnClear="ClearSelectedTableAsync" OnDrop="DropSelectedTableAsync" />
                <div class="actions"><button @onclick="ToggleStructureAsync" aria-expanded="@showStructure" aria-controls="table-structure" disabled="@IsOperationRunning">@(showStructure ? "Hide structure" : "Show structure")</button></div>
                @if (showStructure)
                {
                    <div id="table-structure" class="schema-columns">
                        <TableDataGrid TRow="Column" Rows="columns" ColumnCount="7" ShowLeadingColumn="false"
                                       CellText="StructureCell" CellIsNull="@((Column row, int column) => false)" IsSelected="@((Column row) => false)" EmptyText="No columns found.">
                            <ColumnHeader Context="column">@StructureHeaders[column]</ColumnHeader>
                            <LeadingCell Context="row"></LeadingCell>
                        </TableDataGrid>
                    </div>
                    <p class="muted">Indexes, unique/check constraints and foreign key details are not loaded in this view.</p>
                }
            }
            else
            {
                @if (selected.Kind == "Procedure") { <p>Has parameters: @(Type == "SQLSERVER" ? YesNo(selected.HasParameters) : "Not loaded")</p> }
                <p class="muted">The SQL definition is loaded only when requested.</p>
                <div class="actions">
                    @if (selected.Kind == "View") { <button @onclick="QuerySelectedViewAsync">Query data</button> }
                    @if (selected.Kind == "Procedure") { <button @onclick="RunSelectedProcedureAsync">Run</button> }
                    <button @onclick="ShowDefinitionAsync">View definition</button>
                </div>
            }
        }
    </div>
</section>

@code {
    private string search = "", kind = "All";
    private DefinitionObject? selected;
    private IReadOnlyList<Column> columns = [];
    private bool showStructure;
    private static readonly string[] StructureHeaders = ["Column", "Type", "Primary key", "Auto-generated ID", "Nullable", "Computed", "Default"];
    private string StructureCell(Column column, int index) => index switch
    {
        0 => column.Name, 1 => column.DisplayType(Type), 2 => YesNo(column.IsPrimaryKey),
        3 => YesNo(column.IsIdentity), 4 => YesNo(column.IsNullable),
        5 => column.IsComputed.HasValue ? YesNo(column.IsComputed.Value) : "Not loaded",
        6 => column.DefaultLoaded ? string.IsNullOrEmpty(column.Default) ? "None" : column.Default : "Not loaded",
        _ => ""
    };
    private IReadOnlyList<DefinitionObject> Definitions => Database.Schema?.DefinitionObjects ?? [];
    private IEnumerable<DefinitionObject> Objects => (Database.Schema?.Tables.Select(t => new DefinitionObject("Table", Type == "SQLSERVER" ? t.TableSchemaName : "main", t.Name)) ?? [])
        .Concat(Definitions).Where(o => (kind == "All" || o.Kind == kind) && o.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase));
    private static string YesNo(bool value) => value ? "Yes" : "No";
    public Task QuerySelectedViewAsync() => selected is { Kind: "View" } item ? Context.Preview.PreviewObjectAsync(item) : Task.CompletedTask;
    public Task RunSelectedProcedureAsync() => selected is { Kind: "Procedure" } item ? Context.ProcedureActions.RunSingleAsync(item) : Task.CompletedTask;
    private TableStruct SelectedTable()
    {
        if (selected is not { Kind: "Table" } item) throw new InvalidOperationException("Select a table.");
        return Database.Schema!.Tables.SingleOrDefault(t => t.Name == item.Name && (Type != "SQLSERVER" || t.TableSchemaName == item.Schema))
            ?? throw new InvalidOperationException("The table is no longer available. Refresh the schema.");
    }
    public Task ImportSelectedTableAsync() => Context.TableActions.ImportAsync(SelectedTable());
    public Task ExportSelectedTableAsync() => Context.TableActions.ExportExcelAsync(SelectedTable());
    public Task ClearSelectedTableAsync() => Context.TableActions.ClearAsync(SelectedTable());
    public Task AnalyzeSelectedTableAsync() => Context.TableActions.AnalyzeAsync(SelectedTable());
    public async Task DropSelectedTableAsync()
    {
        var table = SelectedTable();
        await Context.TableActions.DropAsync(table);
        if (!Database.Schema!.Tables.Any(t => t.Name == table.Name && (Type != "SQLSERVER" || t.TableSchemaName == table.TableSchemaName)))
        { selected = null; columns = []; showStructure = false; }
    }
    public Task EditSelectedTableAsync() => RunAsync("Open table editor", async watch =>
    {
        if (selected is not { Kind: "Table" } item) return;
        var table = Database.Schema!.Tables.SingleOrDefault(t => t.Name == item.Name && (Type != "SQLSERVER" || t.TableSchemaName == item.Schema))
            ?? throw new InvalidOperationException("The table is no longer available. Refresh the schema.");
        await OpenTableEditorAsync(table, watch);
    });
    public Task SelectAsync(DefinitionObject item) => RunAsync("Select object", watch =>
    {
        selected = item; columns = []; showStructure = false;
        return Task.CompletedTask;
    });
    public Task ToggleStructureAsync() => RunAsync("Read table structure", async watch =>
    {
        if (showStructure) { showStructure = false; return; }
        if (selected is not { Kind: "Table" } item) return;
        watch.Start();
        var table = SelectedTable();
        var loaded = Type == "SQLITE"
            ? await Task.Run(() => { using var access = (SQLiteDbAccess)Database.OpenAccess(); return access.ReadSchemaColumns(item.Name); })
            : table.Columns;
        columns = loaded; showStructure = true;
    });
    public Task ShowDefinitionAsync() => RunAsync("Read definition", async watch =>
    {
        if (selected is not { Kind: "View" or "Procedure" } item || !Definitions.Contains(item)) return;
        watch.Start();
        var definition = await Task.Run(() => { using var access = Database.OpenAccess(); return ((IDefinitionReader)access).ReadDefinition(item); });
        watch.Stop();
        await Dialogs.ShowDefinitionAsync(item.DisplayName, definition.Sql, definition.Notice);
    });
    public Task RefreshAsync() => RunAsync("Refresh schema", async watch =>
    {
        watch.Start(); await Context.RefreshSchemaAsync(); selected = null; columns = []; showStructure = false;
    });
}
