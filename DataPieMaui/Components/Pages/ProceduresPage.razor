@using DBUtil
@using DataPieMaui.Services.Shared
@inherits WorkspacePageBase
<section class="card">
    @if (IsSqlServer)
    {
        <div class="tabs" aria-label="Procedure types">
            <button class="@(!ParameterizedTab ? "active" : "")" aria-pressed="@(!ParameterizedTab)" @onclick='() => ChangeTab("WithoutParameters")'>Without parameters</button>
            <button class="@(ParameterizedTab ? "active" : "")" aria-pressed="@ParameterizedTab" @onclick='() => ChangeTab("WithParameters")'>With parameters</button>
        </div>
    }
    else { <h2>Available procedures</h2> }
    <ObjectSelection Items="VisibleProcedures" Label="Procedures" AllowSelection="@(!ParameterizedTab)" OnDefinition="Context.Definitions.ShowAsync" OnRunParameters="ParameterAction" />
    @if (!ParameterizedTab)
    {
        <div class="actions"><button class="primary" @onclick="RunProceduresAsync">Run selected procedures</button><button @onclick="ClearSelection">Clear selection</button></div>
    }
</section>

@code {
    private bool IsSqlServer => Model.State.DatabaseType == "SQLSERVER";
    private bool ParameterizedTab => IsSqlServer && Form.ProcedureTab == "WithParameters";
    public List<SelectableObject> VisibleProcedures => Procedures.Where(p => !IsSqlServer || (p.DefinitionObject?.HasParameters == true) == ParameterizedTab).ToList();
    public void ChangeTab(string tab)
    {
        if (IsOperationRunning || tab is not ("WithoutParameters" or "WithParameters")) return;
        Form.ProcedureTab = tab;
        Notify();
    }
    private EventCallback<SelectableObject> ParameterAction => ParameterizedTab
        ? EventCallback.Factory.Create<SelectableObject>(this, RunWithParametersAsync) : default;

    public Task RunWithParametersAsync(SelectableObject item) => Procedures.Contains(item) && item.DefinitionObject is { } target
        ? Context.ProcedureActions.RunWithParametersAsync(target) : Task.CompletedTask;
    public void ClearSelection()
    {
        if (IsOperationRunning) return;
        foreach (var item in VisibleProcedures) item.Selected = false;
        Notify();
    }

    public Task RunProceduresAsync() => ParameterizedTab ? Task.CompletedTask : Context.ProcedureActions.RunProceduresAsync(
        Procedures.Where(x => x.Selected && (!IsSqlServer || x.DefinitionObject?.HasParameters != true))
            .Select(x => x.DefinitionObject ?? throw new InvalidOperationException("Procedure metadata is missing. Reconnect.")).ToArray());
}