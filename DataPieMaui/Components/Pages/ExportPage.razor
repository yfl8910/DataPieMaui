@using DataPieCore
@using DataPieMaui.Services.Shared
@inherits WorkspacePageBase
<section class="card">
    <div class="tabs" aria-label="@L("Export object types", "导出对象类型")">
        @foreach (var tab in new[] { ("Table", L("Tables", "表")), ("View", L("Views", "视图")) })
        {
            <button class="@(Model.Form.ExportTab == tab.Item1 ? "active" : "")" aria-pressed="@(Model.Form.ExportTab == tab.Item1)" @onclick="() => ChangeTab(tab.Item1)">@tab.Item2</button>
        }
    </div>
    <div class="section-heading">
        <span class="muted">Selected across both tabs: @Model.Exports.Count(x => x.Selected && x.Kind == "Table") tables, @Model.Exports.Count(x => x.Selected && x.Kind == "View") views</span>
        <div class="actions"><button @onclick="() => SelectAll(true)">@L("Select all", "全选")</button><button @onclick="() => SelectAll(false)">@L("Clear selection", "清除选择")</button></div>
    </div>
    <ObjectSelection Items="VisibleItems" Label="@(Model.Form.ExportTab == "Table" ? "Tables" : "Views")" OnPreviewItem="PreviewItemAsync" OnDefinition="Context.Definitions.ShowAsync" OnSelectionChanged="SelectionChanged" />
    <div class="actions"><button @onclick='() => ExportBatchAsync("standard")' title="@L("Export all selected objects without formatting", "导出全部选中对象，省略格式")">@L("Excel (Standard)", "Excel（标准）")</button><button class="primary" @onclick='() => ExportBatchAsync("mini")'>@L("Excel (MiniExcel)", "Excel（MiniExcel）")</button><button @onclick='() => ExportBatchAsync("csv")'>@L("CSV folder", "导出到 CSV 文件夹")</button></div>
</section>

@code {
    private List<SelectableObject> VisibleItems => Exports.Where(x => x.Kind == Form.ExportTab).ToList();
    public void ChangeTab(string kind)
    {
        if (IsOperationRunning || kind is not ("Table" or "View")) return;
        Form.ExportTab = kind;
        Notify();
    }
    private void SelectionChanged() => Notify();
    public void SelectAll(bool selected)
    {
        if (IsOperationRunning) return;
        foreach (var item in VisibleItems) item.Selected = selected;
        Notify();
    }

    public Task PreviewObjectAsync(string name) => Context.Preview.PreviewObjectAsync(name);
    public Task PreviewItemAsync(SelectableObject item) => item.DefinitionObject is { Kind: "View" } target
        ? Context.Preview.PreviewObjectAsync(target) : Context.Preview.PreviewObjectAsync(item.Name);

    public Task ExportBatchAsync(string mode) => RunAsync("Batch export", async watch =>
    {
        if (mode is not ("standard" or "mini" or "csv")) throw new ArgumentException("Unsupported export format.", nameof(mode));
        var names = Exports.Where(x => x.Selected).Select(x => x.Name).ToArray();
        if (names.Length == 0) throw new InvalidOperationException("Select the tables or views to export.");
        string type = Type;
        var path = mode == "csv" ? await Desktop.FolderAsync() : await Desktop.SaveAsync(names[0], ".xlsx");
        if (path == null) return;
        var outputs = names.Select(name => Path.Combine(path, FileNames.SafeFileName(name) + ".csv")).ToArray();
        if (mode == "csv")
        {
            if (outputs.Distinct(StringComparer.OrdinalIgnoreCase).Count() != outputs.Length) throw new InvalidOperationException("Some table names produce identical file names. Export them separately to different folders.");
            if (outputs.Any(File.Exists) && !await Dialogs.ConfirmAsync("Replace CSV files", "The destination contains CSV files with the same names. Replace them?", "Replace")) return;
        }
        watch.Start();
        await Task.Run(() =>
        {
            using var access = Database.OpenAccess();
            if (mode == "standard")
            {
                using var workbook = new ExcelExporter(path);
                foreach (string name in names)
                {
                    using var reader = access.GetDataReader(SqlQueryBuilder.BuildSelectAll(name, type));
                    workbook.WriteSheet(name, reader, new ExcelExportOptions { Formatted = false });
                }
                workbook.Complete();
            }
            else if (mode == "mini") ExcelIO.ExportSheetsWithMiniExcel(names, path, access, type);
            else
            {
                for (int i = 0; i < names.Length; i++)
                {
                    using var reader = access.GetDataReader(SqlQueryBuilder.BuildSelectAll(names[i], type));
                    CsvExporter.SaveCsv(reader, outputs[i]);
                }
            }
        });
        watch.Stop();
        State.Status = $"Batch export completed in {watch.Elapsed.TotalSeconds:F1} s · "
            + (mode == "csv" ? "Files: " + string.Join("; ", outputs.Select(Path.GetFullPath))
                : "File: " + Path.GetFullPath(path));
    });
}
