<section class="card"><div class="section-heading"><h2>Tables and views</h2><div class="actions"><button @onclick="() => W.SelectAll(true)">Select all</button><button @onclick="() => W.SelectAll(false)">Clear selection</button></div></div>
    <ObjectSelection Items="W.Exports" Label="Tables and views" OnPreview="W.PreviewObjectAsync" />
    <div class="actions"><button class="primary" @onclick='() => W.ExportBatchAsync("mini")'>Excel (MiniExcel)</button><button @onclick='() => W.ExportBatchAsync("epplus")'>Excel (EPPlus)</button><button @onclick='() => W.ExportBatchAsync("csv")'>CSV folder</button></div>
</section>
@code { [CascadingParameter] public WorkspaceController W { get; set; } = default!; }
