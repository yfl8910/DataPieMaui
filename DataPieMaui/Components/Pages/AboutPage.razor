@inherits LocalizedComponent
<section class="card">
    <span class="version-tag">@L("Version 3.0.0", "版本 3.0.0")</span>
    <h2>DataPieMaui(杨福来)</h2>
    <p>@L("Import, export, and query SQL Server and SQLite databases from one desktop workspace.", "在同一个桌面工作台中导入、导出和查询 SQL Server 与 SQLite 数据。")</p>

    <dl class="about-details">
        <dt>@L("Platform", "平台")</dt>
        <dd>Windows x64</dd>

        <dt>@L("Interface", "界面")</dt>
        <dd>.NET MAUI · Blazor Hybrid</dd>

        <dt>@L("Website", "网站")</dt>
        <dd>https://github.com/yfl8910/DataPieMaui</dd>
    </dl>
</section>
