@using DataPieCore
@inherits WorkspacePageBase

<section class="card schema-browser">
    <div class="tabs" aria-label="Object categories">
        @foreach (var category in new[] { ("Table", "Tables"), ("View", "Views"), ("Procedure", Type == "SQLITE" ? "Procedure scripts" : "Procedures") })
        {
            <button class="@(Browser.Kind == category.Item1 ? "active" : "")" aria-pressed="@(Browser.Kind == category.Item1)" @onclick="() => Browser.ChangeKind(category.Item1)">
                @category.Item2 (@Browser.Objects.Count(o => o.Kind == category.Item1))
            </button>
        }
    </div>
    <div class="actions align-end">
        <label class="grow">Search objects<input @bind="Browser.Search" @bind:event="oninput" placeholder="Schema or object name" /></label>
        <button @onclick="RefreshAsync">Refresh</button>
    </div>
    @if (!string.IsNullOrEmpty(Browser.Error))
    {
        <p class="callout danger" role="alert">@Browser.Error</p>
    }
    <div class="schema-layout">
        <div class="schema-object-list" aria-label="Database objects">
            @foreach (var item in VisibleObjects)
            {
                <button @key="item" class="@(Browser.Selected == item ? "active" : "")" aria-pressed="@(Browser.Selected == item)" @onclick="() => Browser.SelectAsync(item)">@item.DisplayName</button>
            }
            @if (!VisibleObjects.Any())
            {
                <p class="muted">@(Browser.Loaded ? "No matching objects visible in this category." : "Schema has not loaded. Use Refresh to retry.")</p>
            }
        </div>
        <div class="schema-detail">
            @if (Browser.Selected is { } selected)
            {
                <h2>@selected.DisplayName</h2>
                @if (Browser.Details is { } details)
                {
                    @if (!string.IsNullOrEmpty(details.Notice)) { <p class="muted">@details.Notice</p> }
                    @if (selected.Kind != "Procedure")
                    {
                        <h3>Columns (@details.Fields.Count)</h3>
                        <div class="schema-table-scroll">
                            <table class="schema-table">
                                <thead><tr><th>Name</th><th>Type</th><th>Nullable</th><th>Primary key</th>@if (Type == "SQLSERVER") { <th>Identity</th> }<th>Default</th><th>Notes</th></tr></thead>
                                <tbody>
                                    @foreach (var field in details.Fields)
                                    {
                                        <tr><td>@field.Name</td><td>@field.Type</td><td>@(field.Nullable ? "Yes" : "No")</td><td>@(field.PrimaryKey ? "Yes" : "No")</td>@if (Type == "SQLSERVER") { <td>@(field.Identity ? "Yes" : "No")</td> }<td>@field.Default</td><td>@field.Extra</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <h3>Parameters (@details.Parameters.Count)</h3>
                        @if (details.Parameters.Count == 0) { <p class="muted">No parameter metadata available.</p> }
                        else
                        {
                            <div class="schema-table-scroll"><table class="schema-table">
                                <thead><tr><th>Name</th><th>Type</th><th>Direction</th></tr></thead>
                                <tbody>@foreach (var parameter in details.Parameters) { <tr><td>@parameter.Name</td><td>@parameter.Type</td><td>@parameter.Direction</td></tr> }</tbody>
                            </table></div>
                        }
                    }
                    @if (!string.IsNullOrEmpty(details.Definition)) { <SqlDefinitionView @key="selected" Sql="@details.Definition" /> }
                }
            }
            else { <p class="muted">Select an object to view its structure or definition.</p> }
        </div>
    </div>
</section>

@code {
    private DataPieMaui.Services.Shared.SchemaBrowserService Browser => Context.SchemaBrowser;
    private IEnumerable<SchemaObject> VisibleObjects => Browser.Objects.Where(o => o.Kind == Browser.Kind && o.DisplayName.Contains(Browser.Search, StringComparison.OrdinalIgnoreCase));
    protected override Task OnInitializedAsync() => Browser.EnsureAsync();
    public Task RefreshAsync() => Browser.RefreshAsync();
}
